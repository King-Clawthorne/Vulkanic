uint SobolBits(uint index, uint dimension) {
    uint gray = index ^ (index >> 1u), value = 0u;
    dimension = min(dimension, SOBOL_DIMENSIONS - 1u);
    uint directionBase = dimension * 32u;
    while (gray != 0u) {
        uint bit = uint(findLSB(gray));
        value ^= SOBOL_DIRECTION[directionBase + bit];
        gray &= gray - 1u;
    }
    return value;
}

float SobolFloat(uint index, uint dimension, uint scramble) {
    uint bits = SobolBits(index, dimension) ^ Hash(scramble + dimension * 0x9e3779b9u);
    return (float(bits >> 8u) + 0.5) * (1.0 / 16777216.0);
}

float NextFloat(inout uint index, inout uint dimension, uint scramble) {
    float value = SobolFloat(index, dimension, scramble);
    dimension = (dimension + 1u) % SOBOL_DIMENSIONS;
    if (dimension == 0u) ++index;
    return value;
}

vec4 air_density(vec3 pos) {
    float h = max(length(pos) - sceneData.skyRadiiScaleHeights.x, 0.0);
    return vec4(exp(-h / sceneData.skyRadiiScaleHeights.zw), max(0.0, min(h / 15000.0 - 2.0 / 3.0, 8.0 / 3.0 - h / 15000.0)), exp(-h / sceneData.skyVrtParams.w));
}

vec2 ray_sphere(vec3 origin, vec3 dir, float radius) {
    float b = dot(origin, dir);
    float d = b * b - dot(origin, origin) + radius * radius;
    if (d < 0.0) return vec2(-1.0);
    return vec2(-b - sqrt(d), -b + sqrt(d));
}

bool view_segment(vec3 origin, vec3 dir, out float tStart, out float tEnd) {
    vec2 atmosphere = ray_sphere(origin, dir, sceneData.skyRadiiScaleHeights.y);
    vec2 ground = ray_sphere(origin, dir, sceneData.skyRadiiScaleHeights.x);
    tStart = max(atmosphere.x, 0.0);
    tEnd = ground.x > 0.0 ? min(atmosphere.y, ground.x) : atmosphere.y;
    return atmosphere.y >= 0.0;
}

vec4 sun_air_depth(vec3 origin, vec3 dir) {
    float r = length(origin), mu = dot(origin, dir) / r;
    float x = sqrt(clamp((r - sceneData.skyRadiiScaleHeights.x) / (sceneData.skyRadiiScaleHeights.y - sceneData.skyRadiiScaleHeights.x), 0.0, 1.0)) * float(LUT_ALT - 1);
    float y = (0.5 + 0.5 * sign(mu) * sqrt(abs(mu))) * float(LUT_MU - 1);
    ivec2 i = min(ivec2(x, y), ivec2(LUT_ALT - 2, LUT_MU - 2));
    vec2 f = vec2(x, y) - vec2(i);
    int k = i.x * LUT_MU + i.y;
    return mix(mix(transmittanceLut.depth[k], transmittanceLut.depth[k + 1], f.y),
               mix(transmittanceLut.depth[k + LUT_MU], transmittanceLut.depth[k + LUT_MU + 1], f.y), f.x);
}

float band_transmittance(vec4 depth, int band) {
    return exp(-(sceneData.spectralBands[band].x * depth.x + sceneData.mieBands[band].x * depth.y + sceneData.spectralBands[band].w * depth.z + sceneData.mieBands[band].z * depth.w));
}

mat4 mueller(float m11, float m12, float m22, float m33, float m34, float m44) {
    return mat4(m11, m12, 0.0, 0.0, m12, m22, 0.0, 0.0, 0.0, 0.0, m33, -m34, 0.0, 0.0, m34, m44);
}

vec4 stokes_make_physical(vec4 s) {
    s.x = max(s.x, 0.0);
    float p = length(s.yzw);
    return p > s.x ? vec4(s.x, s.yzw * s.x / p) : s;
}

void beam_basis(vec3 d, out vec3 a, out vec3 b) {
    vec3 up = abs(d.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    a = normalize(up - d * dot(d, up));
    b = cross(d, a);
}

vec2 rotation(float c, float sn) { return vec2(c * c - sn * sn, 2.0 * c * sn); }
vec4 rotate(vec4 s, vec2 r) { return vec4(s.x, s.y * r.x + s.z * r.y, -s.y * r.y + s.z * r.x, s.w); }
vec4 vec4_reframe(vec4 s, vec3 oldA, vec3 oldB, vec3 newA) { return rotate(s, rotation(dot(newA, oldA), dot(newA, oldB))); }

mat4 rainbow_mueller(float cosTheta, int band) {
    int bins = max(16, int(sceneData.rainbowOptical.z));
    float fbin = acos(clamp(cosTheta, -1.0, 1.0)) / PI * float(bins - 1);
    int i0 = int(fbin);
    int a = band * bins + i0, b = band * bins + min(i0 + 1, bins - 1);
    vec4 e = mix(rainbowMatrixBuffer.entries[a], rainbowMatrixBuffer.entries[b], fbin - float(i0));
    return mueller(e.x, e.y, e.x, e.z, e.w, e.z);
}

mat4 rayleigh_mueller(float cosTheta) {
    float rho = sceneData.skyVrtParams.y;
    float delta = (1.0 - rho) / (1.0 + 0.5 * rho);
    float deltaP = (1.0 - 2.0 * rho) / max(1.0 - rho, 1.0e-4);
    float mu2 = cosTheta * cosTheta;
    float base = 0.75 * (1.0 + mu2), p33 = 1.5 * cosTheta;
    return mueller(delta * base + (1.0 - delta), -delta * 0.75 * (1.0 - mu2), delta * base, delta * p33, 0.0, delta * deltaP * p33);
}

void scatter_frame(vec3 din, vec3 dout, float cosTheta, out vec4 rot, out vec4 flip) {
    rot = vec4(1.0, 0.0, 1.0, 0.0);
    flip = vec4(1.0);
    vec3 p = cross(din, dout);
    float pl = length(p);
    if (pl < 1.0e-6) {
        if (cosTheta < 0.0) flip = vec4(1.0, 1.0, -1.0, -1.0);
        return;
    }
    p /= pl;
    vec3 ain, bin, aout, bout;
    beam_basis(din, ain, bin);
    beam_basis(dout, aout, bout);
    vec3 inAxis = cross(p, din);
    rot = vec4(rotation(dot(inAxis, ain), dot(inAxis, bin)), rotation(dot(aout, cross(p, dout)), dot(aout, p)));
}

vec4 apply_mueller(mat4 m, vec4 s, vec4 rot, vec4 flip) { return rotate(m * rotate(s, rot.xy), rot.zw) * flip; }

vec4 scatter_rainbow(vec4 sIn, vec3 din, vec3 dout, int band) {
    vec4 rot, flip;
    scatter_frame(din, dout, dot(din, dout), rot, flip);
    return apply_mueller(rainbow_mueller(dot(din, dout), band), sIn, rot, flip);
}

struct ScatterGeom { mat4 rayleigh; vec4 rot, flip; int bin; float frac; };

ScatterGeom scatter_geometry(vec3 din, vec3 dout) {
    ScatterGeom g;
    float cosTheta = clamp(dot(din, dout), -1.0, 1.0);
    g.rayleigh = rayleigh_mueller(cosTheta);
    float fbin = acos(cosTheta) / PI * float(max(2, int(sceneData.skyVrtParams.z)) - 1);
    g.bin = int(floor(fbin));
    g.frac = fbin - float(g.bin);
    scatter_frame(din, dout, cosTheta, g.rot, g.flip);
    return g;
}

mat4 mie_mueller(ScatterGeom g, int aerosol, int band) {
    int bins = max(2, int(sceneData.skyVrtParams.z)), base = (aerosol * SPECTRAL_BANDS + band) * bins;
    vec4 e = mix(mieMatrixBuffer.entries[base + g.bin], mieMatrixBuffer.entries[base + min(g.bin + 1, bins - 1)], g.frac);
    return mueller(e.x, e.y, e.x, e.z, e.w, e.z);
}

vec4 scatter_band(ScatterGeom g, vec4 s, vec3 w, int band) {
    mat4 m = sceneData.spectralBands[band].x * w.x * g.rayleigh + sceneData.mieBands[band].y * w.y * mie_mueller(g, 0, band);
    m += w.z > 0.0 ? sceneData.mieBands[band].w * w.z * mie_mueller(g, 1, band) : mat4(0.0);
    return apply_mueller(m / (4.0 * PI), s, g.rot, g.flip);
}

struct Level {
    vec3 org, dir, pos;
    vec4 air, camDepth, depth0;
    vec2 dirJitter;
    float span, rate, start, stepWeight, sampleWeight;
    int stepIndex, sampleIndex;
    vec4 result[SPECTRAL_BANDS], angular[SPECTRAL_BANDS];
};
const int STACK = int(SpecializedOrders);
Level S[STACK];
uint gRngIndex, gRngDimension, gRngScramble;
vec3 spherical_around(vec3 axis, float theta, float phi) {
    vec3 a, b;
    beam_basis(axis, a, b);
    return normalize(axis * cos(theta) + (a * cos(phi) + b * sin(phi)) * sin(theta));
}

ivec2 cdf_layout(int table) {
    int bins = table < 2 ? max(2, int(sceneData.skyVrtParams.z)) : int(sceneData.rainbowOptical.z);
    return ivec2(bins * (table < 2 ? 2 * SPECTRAL_BANDS + table : SPECTRAL_BANDS), bins);
}

float cdf_at(int table, int i) {
    return table < 2 ? mieMatrixBuffer.entries[i].x : rainbowMatrixBuffer.entries[i].x;
}

float cdf_pdf(int table, float cosTheta) {
    ivec2 info = cdf_layout(table);
    float theta = acos(clamp(cosTheta, -1.0, 1.0));
    int bin = min(int(theta / PI * float(info.y - 1)), info.y - 2);
    return (cdf_at(table, info.x + bin + 1) - cdf_at(table, info.x + bin)) * float(info.y - 1) / (2.0 * PI * PI * max(sin(theta), 1e-8));
}

vec3 cdf_sample(int table, vec3 axis, float u, float phi) {
    ivec2 info = cdf_layout(table);
    int lo = 0, hi = info.y - 1;
    while (hi - lo > 1) {
        int mid = (lo + hi) / 2;
        if (cdf_at(table, info.x + mid) < u) lo = mid;
        else hi = mid;
    }
    float c0 = cdf_at(table, info.x + lo), c1 = cdf_at(table, info.x + hi);
    return spherical_around(axis, (float(lo) + (u - c0) / max(c1 - c0, 1e-20)) * PI / float(info.y - 1), phi);
}

vec3 mie_sample(int aerosol, vec3 axis) {
    float u = NextFloat(gRngIndex, gRngDimension, gRngScramble), phi = 2.0 * PI * NextFloat(gRngIndex, gRngDimension, gRngScramble);
    return cdf_sample(aerosol, axis, u, phi);
}

void begin_step(int d, int steps) {
    float u = (float(S[d].stepIndex) + NextFloat(gRngIndex, gRngDimension, gRngScramble)) / float(steps), k = S[d].rate, len = S[d].span, t, pdf;
    if (k * len < 1.0e-3) {
        t = u * len;
        pdf = 1.0 / len;
    } else {
        float mass = 1.0 - exp(-k * len);
        t = -log(1.0 - u * mass) / k;
        pdf = k * exp(-k * t) / mass;
    }
    S[d].dirJitter = vec2(NextFloat(gRngIndex, gRngDimension, gRngScramble), NextFloat(gRngIndex, gRngDimension, gRngScramble));
    S[d].stepWeight = 1.0 / (float(steps) * pdf);
    S[d].pos = S[d].org + S[d].dir * (S[d].start + t);
    S[d].air = air_density(S[d].pos);
    S[d].camDepth = max(S[d].depth0 - sun_air_depth(S[d].pos, S[d].dir), vec4(0.0));
    for (int b = 0; b < SPECTRAL_BANDS; ++b) S[d].angular[b] = vec4(0.0);
    S[d].sampleIndex = 0;
}

vec4 level_value(bool leaf, ScatterGeom g, int d, int b) {
    if (leaf) return stokes_make_physical(scatter_band(g, vec4(1.0, 0.0, 0.0, 0.0), S[d].result[b].xyz, b));
    return stokes_make_physical(S[d].result[b]);
}

void scatter_order(vec3 origin, vec3 viewDir, vec3 L, int order, int viewSteps, int samples, int secondarySteps, inout vec4 sky[SPECTRAL_BANDS]) {
    int last = clamp(order, 1, STACK) - 1, d = 0;
    S[0].org = origin;
    S[0].dir = viewDir;
    bool entering = true;
    while (true) {
        int steps = d == 0 ? viewSteps : secondarySteps;
        if (entering) {
            entering = false;
            float tEnd;
            if (!view_segment(S[d].org, S[d].dir, S[d].start, tEnd)) {
                if (d-- == 0) return;
                ++S[d].sampleIndex;
                continue;
            }
            vec3 first = S[d].org + S[d].dir * S[d].start;
            S[d].span = max(tEnd - S[d].start, 1.0e-3);
            S[d].depth0 = sun_air_depth(first, S[d].dir);
            vec4 total = max(S[d].depth0 - sun_air_depth(first + S[d].dir * S[d].span, S[d].dir), vec4(0.0));
            float tau = sceneData.spectralBands[6].x * total.x + sceneData.mieBands[6].x * total.y + sceneData.mieBands[6].z * total.w;
            S[d].rate = clamp(tau / S[d].span, 1.0e-12, 8.0 / S[d].span);
            for (int b = 0; b < SPECTRAL_BANDS; ++b) S[d].result[b] = vec4(0.0);
            S[d].stepIndex = 0;
            begin_step(d, steps);
        }
        if (d < last && S[d].sampleIndex < samples) {
            float z = 1.0 - 2.0 * (float(S[d].sampleIndex) + S[d].dirJitter.x) / float(samples);
            float phi = GOLDEN_ANGLE * float(S[d].sampleIndex + S[d].stepIndex * samples) + 2.0 * PI * S[d].dirJitter.y;
            S[d + 1].org = S[d].pos;
            vec3 next = -vec3(sqrt(1.0 - z * z) * vec2(cos(phi), sin(phi)), z).xzy;
            vec3 current = S[d].dir;
            float coarse = sceneData.mieBands[6].w > 0.0 ? 0.2 : 0.0, fine = 0.4 - coarse, choice = NextFloat(gRngIndex, gRngDimension, gRngScramble);
            if (choice < fine) next = mie_sample(0, L);
            else if (choice < 0.4) next = mie_sample(1, L);
            else if (choice < 0.4 + fine) next = mie_sample(0, current);
            else if (choice < 0.8) next = mie_sample(1, current);
            float cosSun = dot(next, L), cosCurrent = dot(next, current);
            float pdf = 0.2 / (4.0 * PI) + fine * (cdf_pdf(0, cosSun) + cdf_pdf(0, cosCurrent));
            pdf += coarse > 0.0 ? coarse * (cdf_pdf(1, cosSun) + cdf_pdf(1, cosCurrent)) : 0.0;
            S[d].sampleWeight = 1.0 / (pdf * float(samples));
            S[++d].dir = next;
            entering = true;
            continue;
        }
        vec4 midDepth = S[d].camDepth;
        if (d < last) {
            for (int b = 0; b < SPECTRAL_BANDS; ++b)
                S[d].result[b] += S[d].angular[b] * (band_transmittance(midDepth, b) * S[d].stepWeight);
        } else if (ray_sphere(S[d].pos, L, sceneData.skyRadiiScaleHeights.x).x <= 0.0) {
            vec4 depth = sun_air_depth(S[d].pos, L);
            for (int b = 0; b < SPECTRAL_BANDS; ++b)
                S[d].result[b].xyz += S[d].air.xyw * (band_transmittance(midDepth, b) * S[d].stepWeight * sceneData.spectralBands[b].y * sceneData.sunDisk.x * band_transmittance(depth, b));
        }
        if (++S[d].stepIndex < steps) {
            begin_step(d, steps);
            continue;
        }
        bool leaf = d == last;
        ScatterGeom sunGeom;
        if (leaf) sunGeom = scatter_geometry(-L, -S[d].dir);
        int child = d;
        if (d-- == 0) {
            for (int b = 0; b < SPECTRAL_BANDS; ++b) sky[b] += level_value(leaf, sunGeom, child, b);
            return;
        }
        ScatterGeom g = scatter_geometry(-S[child].dir, -S[d].dir);
        for (int b = 0; b < SPECTRAL_BANDS; ++b)
            S[d].angular[b] += scatter_band(g, level_value(leaf, sunGeom, child, b), S[d].air.xyw, b) * S[d].sampleWeight;
        ++S[d].sampleIndex;
    }
}

vec4[SPECTRAL_BANDS] render_sky(vec3 viewDir, vec3 L) {
    vec3 origin = vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0);
    vec4 sky[SPECTRAL_BANDS];
    for (int b = 0; b < SPECTRAL_BANDS; ++b) sky[b] = vec4(0.0);
    float groundT = ray_sphere(origin, viewDir, sceneData.skyRadiiScaleHeights.x).x;
    int orders = groundT > 0.0 ? 1 : int(SpecializedOrders != 0 ? SpecializedOrders : sceneData.skySampleCounts.w);
    for (int order = 1; order <= orders; ++order)
        scatter_order(origin, viewDir, L, order, int(SpecializedViewSteps != 0 ? SpecializedViewSteps : sceneData.skySampleCounts.y), int(SpecializedSecondarySamples != 0 ? SpecializedSecondarySamples : sceneData.skySampleCounts.x), int(SpecializedSamples != 0 ? SpecializedSamples : sceneData.skySampleCounts.z), sky);
    vec3 apparent = sceneData.apparentSun.xyz;
    vec3 vertical = normalize(vec3(0.0, 1.0, 0.0) - apparent * apparent.y);
    vec2 offset = vec2(dot(viewDir, cross(vertical, apparent)), dot(viewDir, vertical) / sceneData.apparentSun.w);
    float r = dot(viewDir, apparent) > 0.0 ? length(offset) : 1.0;
    float disk = 1.0 - smoothstep(sceneData.skySunDirectionRadius.w - sceneData.skyVrtParams.x, sceneData.skySunDirectionRadius.w + sceneData.skyVrtParams.x, r);
    float limbMu = sqrt(max(0.0, 1.0 - r * r / (sceneData.skySunDirectionRadius.w * sceneData.skySunDirectionRadius.w)));
    vec4 depth = sun_air_depth(origin, viewDir);
    bool sunVisible = disk > 0.0 && groundT <= 0.0;
    vec3 solarRadial = cross(vertical, apparent) * offset.x + vertical * offset.y * sceneData.apparentSun.w;
    float radialLength = length(solarRadial);
    vec3 sunA, sunB;
    beam_basis(-viewDir, sunA, sunB);
    float cos2Limb = 0.0, sin2Limb = 0.0;
    if (radialLength > 1.0e-8) {
        vec3 limbTangent = cross(apparent, solarRadial / radialLength);
        float tangentA = dot(limbTangent, sunA), tangentB = dot(limbTangent, sunB);
        float tangentNorm = max(tangentA * tangentA + tangentB * tangentB, 1.0e-12);
        cos2Limb = (tangentA * tangentA - tangentB * tangentB) / tangentNorm;
        sin2Limb = 2.0 * tangentA * tangentB / tangentNorm;
    }
    for (int b = 0; b < SPECTRAL_BANDS; ++b) {
        float wavelengthNm = sceneData.spectralBands[b].z;
        float limbIntensity = solar_limb_intensity(limbMu, wavelengthNm);
        float limbPolarization = solar_limb_polarization(limbMu, wavelengthNm, limbIntensity);
        float intensity = sunVisible ? disk * sceneData.spectralBands[b].y * limbIntensity * band_transmittance(depth, b) : 0.0;
        sky[b] += intensity * vec4(1.0, limbPolarization * cos2Limb, limbPolarization * sin2Limb, 0.0);
        sky[b] = stokes_make_physical(sky[b]);
    }
    return sky;
}

vec2 ray_ellipsoid(vec3 origin, vec3 dir) {
    vec3 o = rain_frame(origin - sceneData.rainbowCenterEnabled.xyz);
    vec3 d = rain_frame(dir);
    float a = dot(d, d), b = dot(o, d), c = dot(o, o) - 1.0;
    float discriminant = b * b - a * c;
    if (discriminant < 0.0) return vec2(-1.0);
    return vec2(-b - sqrt(discriminant), -b + sqrt(discriminant)) / a;
}

float rainbow_density(vec3 localPosition) {
    float q = length(rain_frame(localPosition - sceneData.rainbowCenterEnabled.xyz));
    float softness = sceneData.rainbowRadiiEdge.w;
    if (softness <= 0.0) return q <= 1.0 ? 1.0 : 0.0;
    return 1.0 - smoothstep(1.0 - softness, 1.0, q);
}

float rain_segment_tau(vec3 origin, vec3 direction, float start, float end) {
    if (end <= start) return 0.0;
    float softness = sceneData.rainbowRadiiEdge.w;
    if (softness <= 0.0) return sceneData.rainbowOptical.y * (end - start);

    vec3 o = rain_frame(origin + direction * start - sceneData.rainbowCenterEnabled.xyz);
    vec3 d = rain_frame(direction);
    float a = dot(d, d), b = dot(o, d), c = dot(o, o);
    float closest = clamp(-b / a, start, end);
    float qMin = sqrt(max(a * closest * closest + 2.0 * b * closest + c, 0.0));
    float inner = 1.0 - softness;
    float integral = 0.0;
    if (qMin < inner) {
        float innerRoot = sqrt(max(a * inner * inner - a * c + b * b, 0.0));
        float lo = clamp((-b - innerRoot) / a, start, end);
        float hi = clamp((-b + innerRoot) / a, start, end);
        integral += max(hi - lo, 0.0);
    }

    float smoothLo = max(start, (-b - sqrt(max(a * a - a * c + b * b, 0.0))) / a);
    float smoothHi = min(end, (-b + sqrt(max(a * a - a * c + b * b, 0.0))) / a);
    if (smoothHi > smoothLo) {
        float t0 = smoothLo, t1 = smoothHi;
        float r0 =  sqrt(max(a * t0 * t0 + 2.0 * b * t0 + c, 0.0));
        float r1 =  sqrt(max(a * t1 * t1 + 2.0 * b * t1 + c, 0.0));
        float x0 = clamp((r0 - inner) / softness, 0.0, 1.0);
        float x1 = clamp((r1 - inner) / softness, 0.0, 1.0);
        float discriminant = a * c - b * b;
        float rootPrimitive0 = (t0 + b / a) * r0;
        float rootPrimitive1 = (t1 + b / a) * r1;
        if (discriminant > 1e-12) {
            rootPrimitive0 += discriminant / a * asinh((a * t0 + b) / sqrt(discriminant));
            rootPrimitive1 += discriminant / a * asinh((a * t1 + b) / sqrt(discriminant));
        }
        float rootIntegral = 0.5 * (rootPrimitive1 - rootPrimitive0);
        float smoothIntegral = (t1 - t0) * (1.0 - 0.5 * inner) -
                               (0.75 * (x1 * x1 - x0 * x0) - 0.25 * (x1 * x1 * x1 - x0 * x0 * x0)) * softness;
        integral += smoothIntegral - rootIntegral / softness;
    }
    return sceneData.rainbowOptical.y * max(integral, 0.0);
}

vec2 rain_segment(vec3 origin, vec3 direction) {
    vec2 hit = ray_ellipsoid(origin, direction);
    hit.x = max(hit.x, 0.0);
    float ground = ray_sphere(origin + vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0), direction, sceneData.skyRadiiScaleHeights.x).x;
    hit.y = ground > 0.0 ? min(hit.y, ground) : hit.y;
    return hit;
}

float rain_direction_pdf(float cosTheta) { return 0.9 * cdf_pdf(2, cosTheta) + 0.1 / (4.0 * PI); }

vec3 rain_sample_direction(vec3 axis, inout uint index, inout uint dimension, uint scramble) {
    float branch = NextFloat(index, dimension, scramble), u = NextFloat(index, dimension, scramble), phi = 2.0 * PI * NextFloat(index, dimension, scramble);
    if (branch < 0.9) return cdf_sample(2, axis, u, phi);
    return spherical_around(axis, acos(1.0 - 2.0 * u), phi);
}

vec4[SPECTRAL_BANDS] integrate_rainbow(vec3 viewDir, vec3 sun, uint index, uint scramble) {
    vec4 result[SPECTRAL_BANDS];
    for (int b = 0; b < SPECTRAL_BANDS; ++b) result[b] = vec4(0.0);
    int orders = clamp(int(sceneData.rainbowMultiple.x), 1, MAX_SCATTER_ORDER);
    int samples = max(1, int(sceneData.rainbowMultiple.y));
    if (!(SpecializedRainbow && sceneData.rainbowCenterEnabled.w > 0.5 && sceneData.rainbowOptical.x > 0.0)) return result;
    float extinction = sceneData.rainbowOptical.y;
    for (int sampleIndex = 0; sampleIndex < samples; ++sampleIndex) {
        uint sobolIndex = index + uint(sampleIndex), dimension = 2u;
        vec3 origin = vec3(0.0), direction = viewDir, pathDirections[MAX_SCATTER_ORDER];
        float throughput = 1.0;
        vec4 airPath = vec4(0.0);
        for (int vertex = 0; vertex < orders; ++vertex) {
            vec2 hit = rain_segment(origin, direction);
            float lengthInRain = hit.y - hit.x;
            if (lengthInRain <= 0.0) break;
            float tau = extinction * lengthInRain;
            float mass = tau < 0.001 ? tau * (1.0 - 0.5 * tau + tau * tau / 6.0) : 1.0 - exp(-tau);
            float u = SobolFloat(sobolIndex, dimension++, scramble ^ uint(sampleIndex) * 1973u ^ uint(vertex) * 0x68bc21ebu);
            float distance = tau < 0.001 ? u * lengthInRain : -log(1.0 - u * mass) / extinction;
            float pdf = tau < 0.001 ? 1.0 / lengthInRain : extinction * exp(-extinction * distance) / mass;
            vec3 p = origin + direction * (hit.x + distance);
            float density = rainbow_density(p);
            if (density <= 0.0) break;
            throughput *= sceneData.rainbowOptical.x * density * exp(-rain_segment_tau(origin, direction, hit.x, hit.x + distance)) / pdf;
            pathDirections[vertex] = direction;
            vec3 earth = p + vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0);
            airPath += max(sun_air_depth(origin + vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0), direction) - sun_air_depth(earth, direction), vec4(0.0));
            if (ray_sphere(earth, sun, sceneData.skyRadiiScaleHeights.x).x <= 0.0) {
                vec4 air = sun_air_depth(earth, sun) + airPath;
                float sunT = exp(-rain_segment_tau(p, sun, 0.0, max(rain_segment(p, sun).y, 0.0)));
                for (int band = 0; band < SPECTRAL_BANDS; ++band) {
                    vec4 s = scatter_rainbow(vec4(1.0, 0.0, 0.0, 0.0), -sun, -direction, band) / (4.0 * PI);
                    for (int previous = vertex - 1; previous >= 0; --previous)
                        s = scatter_rainbow(s, -pathDirections[previous + 1], -pathDirections[previous], band) / (4.0 * PI);
                    result[band] += s * (throughput * sceneData.sunDisk.x * sunT * band_transmittance(air, band) * sceneData.spectralBands[band].y / float(samples));
                }
            }
            if (vertex + 1 < orders) {
                vec3 next = NextFloat(sobolIndex, dimension, scramble) < 0.5
                                ? -rain_sample_direction(-direction, sobolIndex, dimension, scramble)
                                : rain_sample_direction(sun, sobolIndex, dimension, scramble);
                throughput /= 0.5 * (rain_direction_pdf(dot(next, direction)) + rain_direction_pdf(dot(next, sun)));
                origin = p;
                direction = next;
            }
        }
    }
    return result;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.imageSize.x || pixel.y >= pc.imageSize.y) return;
    uint pixelSeed = Hash(pixel.x + pixel.y * 9781u), frameSampleBase = uint(pc.frame.x) * uint(max(1.0, pc.forward.w));
    uint rngDimension = 2u, rngScramble = pixelSeed ^ 0x5bd1e995u;

    uint samplesPerPixel = uint(pc.forward.w);
    bool polarized = pc.polarizer.x > 0.5;
    float linAmp = cos(2.0 * pc.polarizer.z);
    vec4 analyzer = vec4(1.0, linAmp * cos(2.0 * pc.polarizer.y), linAmp * sin(2.0 * pc.polarizer.y), sin(2.0 * pc.polarizer.z));
    vec3 sun = normalize(sceneData.skySunDirectionRadius.xyz);

    vec3 accumulatedXyz = vec3(0.0);
    for (uint localSample = 0; localSample < samplesPerPixel; ++localSample) {
        uint sampleNumber = frameSampleBase + localSample;
        vec2 jitter = vec2(SobolFloat(sampleNumber, 0u, pixelSeed), SobolFloat(sampleNumber, 1u, pixelSeed));
        vec2 uv = (vec2(pixel) + jitter) / vec2(pc.imageSize);
        vec2 screen = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
        vec3 viewDir = normalize(pc.forward.xyz + pc.right.xyz * screen.x + pc.up.xyz * screen.y);
        vec3 frameX = normalize(pc.right.xyz - viewDir * dot(pc.right.xyz, viewDir)), na, nb;
        beam_basis(-viewDir, na, nb);
        vec4 rainbow[SPECTRAL_BANDS];
        for (int b = 0; b < SPECTRAL_BANDS; ++b) rainbow[b] = vec4(0.0);
        vec2 rainHit = (SpecializedRainbow && sceneData.rainbowCenterEnabled.w > 0.5 && sceneData.rainbowOptical.x > 0.0) ? rain_segment(vec3(0.0), viewDir) : vec2(0.0);
        if (subgroupAny(rainHit.y > rainHit.x)) {
            rainbow = integrate_rainbow(viewDir, sun, sampleNumber, pixelSeed);
        }
        gRngIndex = sampleNumber;
        gRngDimension = rngDimension;
        gRngScramble = rngScramble;
        vec4 sky[SPECTRAL_BANDS] = render_sky(viewDir, sun);
        float night = 1.0 - smoothstep(-0.18, -0.02, sun.y);
        if (night > 0.0 && ray_sphere(vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0), viewDir, sceneData.skyRadiiScaleHeights.x).x <= 0.0) {
            vec4 star = procedural_star(viewDir);
            if (star.x > 0.0) {
                vec4 starDepth = sun_air_depth(vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0), viewDir);
                for (int band = 0; band < SPECTRAL_BANDS; ++band) {
                    float wavelengthNm = sceneData.spectralBands[band].z;
                    sky[band].x += night * star.x * stellar_spectrum(wavelengthNm, star.y) * band_transmittance(starDepth, band);
                }
            }
        }

        vec3 sampleXyz = vec3(0.0);
        for (int band = 0; band < SPECTRAL_BANDS; ++band) {
            vec4 total = sky[band] + rainbow[band];
            float radiance = polarized ? 0.5 * dot(analyzer, vec4_reframe(total, na, nb, frameX)) : total.x;
            sampleXyz += max(radiance, 0.0) * sceneData.cieXyz[band].xyz;
        }
        accumulatedXyz += sampleXyz;
    }
    vec3 xyz = accumulatedXyz / float(max(1u, samplesPerPixel));
    uint index = pixel.y * pc.imageSize.x + pixel.x;
    vec4 previous = pc.frame.z > 0.5 ? vec4(0.0) : accumulation.pixels[index];
    xyz = previous.xyz + (xyz - previous.xyz) / (previous.w + 1.0);
    accumulation.pixels[index] = vec4(xyz, previous.w + 1.0);
    vec3 rgb = mat3(3.2406, -0.9689, 0.0557, -1.5372, 1.8758, -0.2040, -0.4986, 0.0415, 1.0570) * xyz;
    float lowest = min(rgb.r, min(rgb.g, rgb.b));
    rgb = lowest < 0.0 && xyz.y > 0.0 ? xyz.y + (rgb - xyz.y) * (xyz.y / (xyz.y - lowest)) : rgb;
    rgb = max(rgb, vec3(0.0)) * pc.frame.y;

    const mat3 agxInset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051, 0.0784335999999992, 0.878468636469772, 0.0784336,
                               0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 agxOutset = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438, -0.0980208811401368, 1.15190312990417,
                                -0.0980434501171241, -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    vec3 x = (clamp(log2(max(agxInset * rgb, vec3(1.0e-10))), -12.47393, 4.026069) + 12.47393) / 16.499999;
    vec3 x2 = x * x, x4 = x2 * x2;
    x = 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
    vec3 c = min(pow(max(agxOutset * x, vec3(0.0)), vec3(2.2)), 1.0);
    imageStore(outputImage, ivec2(pixel), vec4(mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, 12.92 * c, lessThanEqual(c, vec3(0.0031308))), 1.0));
}
