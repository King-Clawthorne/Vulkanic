vec3 rain_frame(vec3 v) { return vec3(dot(v, sceneData.rainbowAxisX.xyz), v.y, dot(v, sceneData.rainbowAxisZ.xyz)) / sceneData.rainbowRadiiEdge.xyz; }
uint Hash(uint x);

float solar_limb_intensity(float mu, float wavelengthNm) {
    float wavelengthUm = wavelengthNm * 0.001;
    float inv = 1.0 / wavelengthUm, inv5 = inv * inv * inv * inv * inv;
    float coefficients[6];
    if (wavelengthNm >= 422.57) {
        coefficients[0] = 0.75267 - 0.265577 * inv;
        coefficients[1] = 0.93874 + 0.265577 * inv - 0.004095 * inv5;
        coefficients[2] = -1.89287 + 0.012582 * inv5;
        coefficients[3] = 2.42234 - 0.017117 * inv5;
        coefficients[4] = -1.71150 + 0.011977 * inv5;
        coefficients[5] = 0.49062 - 0.003347 * inv5;
    } else {
        // The measured fit has separate short-wavelength parameterizations and a gap near the Balmer jump.
        // Use its published disk-average power-law approximation below the polynomial fit's valid range.
        float alpha = clamp(-0.507 + 0.441 * inv, 0.0, 1.0);
        return 0.5 * (alpha + 2.0) * pow(max(mu, 0.0), alpha);
    }
    float profile = coefficients[5];
    for (int i = 4; i >= 0; --i) profile = profile * mu + coefficients[i];
    float diskAverage = 0.0;
    for (int i = 0; i < 6; ++i) diskAverage += 2.0 * coefficients[i] / float(i + 2);
    return profile / diskAverage;
}

// Semi-empirical quiet-Sun continuum polarization (Stenflo 2005).
// Empirical p_c at mu=0.1 is linearly interpolated from 25 nm averages of the
// IRSOL SS2 atlas continuum column, in percent. The atlas reaches 698.7 nm.
float solar_limb_polarization(float mu, float wavelengthNm, float intensityRatio) {
    const float continuumPercent[12] = float[12](0.188052, 0.115055, 0.073447, 0.048919, 0.033996, 0.024649,
                                                  0.018648, 0.014720, 0.012123, 0.010416, 0.009340, 0.008744);
    float wavelength = clamp(wavelengthNm, 400.0, 675.0);
    int lower = clamp(int(floor(0.04 * wavelength - 16.0)), 0, 10);
    float t = 0.04 * wavelength - 16.0 - float(lower);
    float pAtMuPoint = mix(continuumPercent[lower], continuumPercent[lower + 1], t) * 0.01;
    float fitWavelengthNm = clamp(wavelengthNm, 400.0, 700.0);
    float m = 0.14 - 1.6e-5 * fitWavelengthNm;
    float limbFactor = (1.0 - mu * mu) / max((mu + m) * intensityRatio, 1.0e-6);
    float referenceIntensity = solar_limb_intensity(0.1, wavelengthNm);
    float referenceFactor = 0.99 / max((0.1 + m) * referenceIntensity, 1.0e-6);
    return pAtMuPoint * limbFactor / referenceFactor;
}

vec4 procedural_star(vec3 direction) {
    const vec2 grid = vec2(720.0, 360.0);
    vec2 uv = vec2(atan(direction.z, direction.x) / (2.0 * PI) + 0.5,
                  acos(clamp(direction.y, -1.0, 1.0)) / PI);
    vec2 cellPosition = uv * grid;
    ivec2 baseCell = ivec2(floor(cellPosition));
    vec2 localPosition = fract(cellPosition);
    vec4 stars = vec4(0.0); // brightness, temperature, angular radius, reserved
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 cell = baseCell + ivec2(x, y);
            cell.x = (cell.x % int(grid.x) + int(grid.x)) % int(grid.x);
            uint seed = Hash(uint(cell.x) * 1973u ^ uint(cell.y) * 9277u ^ 0x68bc21ebu);
            float selection = float(Hash(seed ^ 0xa511e9b3u) >> 8u) * (1.0 / 16777216.0);
            if (selection > 0.11) continue;
            vec2 starPosition = vec2(float(Hash(seed ^ 0x63d83595u) >> 8u),
                                     float(Hash(seed ^ 0xb5297a4du) >> 8u)) * (1.0 / 16777216.0);
            vec2 delta = vec2(x, y) + starPosition - localPosition;
            delta.x *= cos(PI * uv.y);
            float radius = mix(0.035, 0.09, float(Hash(seed ^ 0x1b56c4e9u) >> 8u) * (1.0 / 16777216.0));
            float distanceToStar = length(delta);
            float core = 1.0 - smoothstep(radius * 0.2, radius, distanceToStar);
            float intensity = 0.015 + 0.12 * pow(float(Hash(seed ^ 0x5be0cd19u) >> 8u) * (1.0 / 16777216.0), 8.0);
            if (core > stars.x) {
                stars.x = core * intensity;
                stars.y = mix(3200.0, 10000.0, float(Hash(seed ^ 0xc2b2ae35u) >> 8u) * (1.0 / 16777216.0));
            }
        }
    }
    return stars;
}

float stellar_spectrum(float wavelengthNm, float temperature) {
    float inverse550 = 1.4387769e7 / (550.0 * temperature);
    float inverseWavelength = 1.4387769e7 / (wavelengthNm * temperature);
    return pow(550.0 / wavelengthNm, 5.0) * (exp(inverse550) - 1.0) / (exp(inverseWavelength) - 1.0);
}

uint Hash(uint x) {
    x = x * 747796405u + 2891336453u;
    x = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
    return (x >> 22u) ^ x;
}

