#version 460

// One 8x8 workgroup tile shades independent output pixels. The pipeline's
// specialization constants and descriptor ordering are paired with C++ setup.

#extension GL_KHR_shader_subgroup_vote : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Descriptor binding contract with VulkanPathTracer::CreateDescriptorSetLayout:
// 0 output image, 1 scene constants, 2 Mie table, 3 rainbow table,
// 4 atmospheric depth LUT, and 5 persistent XYZ accumulation.
layout(set = 0, binding = 0) uniform writeonly image2D outputImage;
layout(set = 0, binding = 1) uniform SceneData {
    vec4 skySpectralParams, skyRadiiScaleHeights, skySunDirectionRadius;
    vec4 skyVrtParams, rainbowCenterEnabled, rainbowRadiiEdge, rainbowOptical;
    uvec4 rainbowMultiple;
    vec4 spectralBands[17], cieXyz[17], sunDisk;
    vec4 mieBands[17], rainbowAxisX, rainbowAxisZ, apparentSun, starConfig;
}
sceneData;
layout(std430, set = 0, binding = 2) readonly buffer MieMatrixBuffer {
    vec4 entries[];
}
mieMatrixBuffer;
layout(std430, set = 0, binding = 3) readonly buffer RainbowMatrixBuffer {
    vec4 entries[];
}
rainbowMatrixBuffer;
layout(std430, set = 0, binding = 4) readonly buffer TransmittanceBuffer {
    vec4 depth[];
}
transmittanceLut;
layout(std430, set = 0, binding = 5) buffer AccumulationBuffer {
    vec4 pixels[];
}
accumulation;
layout(push_constant) uniform PushConstants {
    vec4 forward, right, up, frame, polarizer;
    uvec2 imageSize;
}
pc;

// Quality controls supplied as specialization constants when the pipeline is
// created. These are compile-time shader values for the selected pipeline.
layout(constant_id = 0) const uint SpecializedOrders = 1;
layout(constant_id = 1) const uint SpecializedViewSteps = 0;
layout(constant_id = 2) const uint SpecializedSamples = 0;
layout(constant_id = 3) const uint SpecializedSecondarySamples = 0;
layout(constant_id = 4) const bool SpecializedRainbow = true;

// CPU-generated LUT dimensions and shader table indexing depend on these values.
const float PI = 3.14159265358979323846;
const int SPECTRAL_BANDS = 17;
const float GOLDEN_ANGLE = 2.39996322972865332;
const int MAX_SCATTER_ORDER = 3;
const int LUT_ALT = 64, LUT_MU = 256;

// Transform a world-space point/vector into the unit-space ellipsoid used for
// rain volume intersection and density evaluation.
vec3 rain_frame(vec3 v) {
    return vec3(dot(v, sceneData.rainbowAxisX.xyz), v.y, dot(v, sceneData.rainbowAxisZ.xyz)) /
           sceneData.rainbowRadiiEdge.xyz;
}
uint Hash(uint x);

float ToUnit(uint x) {
    return (float(x >> 9u) + 0.5) * (1.0 / 8388608.0);
}

// Analytic limb-darkening approximation evaluated per wavelength band. mu is
// the cosine of the angular distance from the apparent solar-disk centre.
float solar_limb_intensity(float mu, float wavelengthNm) {
    float wavelengthUm = wavelengthNm * 0.001;
    float inv = 1.0 / wavelengthUm, inv5 = inv * inv * inv * inv * inv;
    float coefficients[6];
    if (wavelengthNm >= 422.57) {
        coefficients[0] = 0.75267 - 0.265577 * inv;
        coefficients[1] = 0.93874 + 0.265577 * inv - 0.004095 * inv5;
        coefficients[2] = -1.89287 + 0.012582 * inv5;
        coefficients[3] = 2.42234 - 0.017117 * inv5;
        coefficients[4] = -1.71150 + 0.011977 * inv5;
        coefficients[5] = 0.49062 - 0.003347 * inv5;
    } else {
        float alpha = clamp(-0.507 + 0.441 * inv, 0.0, 1.0);
        return 0.5 * (alpha + 2.0) * pow(max(mu, 0.0), alpha);
    }
    float profile = coefficients[5];
    for (int i = 4; i >= 0; --i)
        profile = profile * mu + coefficients[i];
    float diskAverage = 0.0;
    for (int i = 0; i < 6; ++i)
        diskAverage += 2.0 * coefficients[i] / float(i + 2);
    return profile / diskAverage;
}

float solar_limb_polarization(float mu, float wavelengthNm, float intensityRatio) {
    const float continuumPercent[12] = float[12](0.188052, 0.115055, 0.073447, 0.048919, 0.033996, 0.024649, 0.018648,
                                                 0.014720, 0.012123, 0.010416, 0.009340, 0.008744);
    float wavelength = clamp(wavelengthNm, 400.0, 675.0);
    int lower = clamp(int(floor(0.04 * wavelength - 16.0)), 0, 10);
    float t = 0.04 * wavelength - 16.0 - float(lower);
    float pAtMuPoint = mix(continuumPercent[lower], continuumPercent[lower + 1], t) * 0.01;
    float fitWavelengthNm = clamp(wavelengthNm, 400.0, 700.0);
    float m = 0.14 - 1.6e-5 * fitWavelengthNm;
    float limbFactor = (1.0 - mu * mu) / max((mu + m) * intensityRatio, 1.0e-6);
    float referenceIntensity = solar_limb_intensity(0.1, wavelengthNm);
    float referenceFactor = 0.99 / max((0.1 + m) * referenceIntensity, 1.0e-6);
    return pAtMuPoint * limbFactor / referenceFactor;
}

// Deterministic hash-based star field. It is evaluated only for night rays that
// miss the planet, so it needs no geometry or per-frame random state.
vec4 procedural_star(vec3 direction) {
    const vec2 grid = vec2(720.0, 360.0);
    vec2 uv = vec2(atan(direction.z, direction.x) / (2.0 * PI) + 0.5, acos(clamp(direction.y, -1.0, 1.0)) / PI);
    vec2 cellPosition = uv * grid;
    ivec2 baseCell = ivec2(floor(cellPosition));
    vec2 localPosition = fract(cellPosition);
    vec4 stars = vec4(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 cell = baseCell + ivec2(x, y);
            cell.x = (cell.x % int(grid.x) + int(grid.x)) % int(grid.x);
            uint seed = Hash(uint(cell.x) * 1973u ^ uint(cell.y) * 9277u ^ 0x68bc21ebu);
            float selection = ToUnit(Hash(seed ^ 0xa511e9b3u));
            if (selection > sceneData.starConfig.x)
                continue;
            vec2 starPosition =
                vec2(ToUnit(Hash(seed ^ 0x63d83595u)), ToUnit(Hash(seed ^ 0xb5297a4du)));
            vec2 delta = vec2(x, y) + starPosition - localPosition;
            delta.x *= cos(PI * uv.y);
            float radius = mix(0.035, 0.09, ToUnit(Hash(seed ^ 0x1b56c4e9u)));
            float distanceToStar = length(delta);
            float core = 1.0 - smoothstep(radius * 0.2, radius, distanceToStar);
            float intensity = 0.015 + 0.12 * pow(ToUnit(Hash(seed ^ 0x5be0cd19u)), 8.0);
            if (core > stars.x) {
                stars.x = core * intensity;
                stars.y = mix(3200.0, 10000.0, ToUnit(Hash(seed ^ 0xc2b2ae35u)));
            }
        }
    }
    return stars;
}

float stellar_spectrum(float wavelengthNm, float temperature) {
    float inverse550 = 1.4387769e7 / (550.0 * temperature);
    float inverseWavelength = 1.4387769e7 / (wavelengthNm * temperature);
    return pow(550.0 / wavelengthNm, 5.0) * (exp(inverse550) - 1.0) / (exp(inverseWavelength) - 1.0);
}

uint Hash(uint x) {
    x = x * 747796405u + 2891336453u;
    x = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
    return (x >> 22u) ^ x;
}

// Independent nested scrambles preserve Sobol stratification across frames and
// branches while breaking up correlations left by digital shifts alone.
// Keep all 32 index bits, then convert only 24 bits so rounding
// cannot produce 1.0 and escape an inverse-CDF sampler's domain.
#include "sobol.glsl"

uint NestedUniformScramble(uint value, uint seed) {
    value = bitfieldReverse(value);
    value ^= value * 0x3d20adeau;
    value += seed;
    value *= (seed >> 16u) | 1u;
    value ^= value * 0x05526c56u;
    value ^= value * 0x53a22864u;
    return bitfieldReverse(value);
}

// The caller shuffles once per sample; branch seeds only scramble the output.
float SampleFloat(uint index, uint dimension, uint scramble) {
    uint seed = Hash(scramble ^ (dimension * 0x9e3779b9u));
    if (dimension >= SAMPLE_DIMENSIONS)
        return ToUnit(Hash(index ^ seed));
    uint value = 0u;
    while (index != 0u) {
        value ^= SOBOL_DIRECTIONS[dimension * 32u + uint(findLSB(index))];
        index &= index - 1u;
    }
    return ToUnit(NestedUniformScramble(value, seed));
}

float NextFloat(inout uint index, inout uint dimension, uint scramble) {
    return SampleFloat(index, dimension++, scramble);
}

// Density-weighted path columns are ordered Rayleigh, fine aerosol, ozone,
// coarse aerosol, matching the CPU transmittance table and scene coefficients.
vec4 air_density(vec3 pos) {
    float h = max(length(pos) - sceneData.skyRadiiScaleHeights.x, 0.0);
    return vec4(exp(-h / sceneData.skyRadiiScaleHeights.zw),
                max(0.0, min(h / 15000.0 - 2.0 / 3.0, 8.0 / 3.0 - h / 15000.0)), exp(-h / sceneData.skyVrtParams.w));
}

// Returns near/far ray parameters; a negative near hit denotes an origin inside
// the sphere. Callers use this convention for both planet and atmosphere tests.
vec2 ray_sphere(vec3 origin, vec3 dir, float radius) {
    float b = dot(origin, dir);
    float d = b * b - dot(origin, origin) + radius * radius;
    if (d < 0.0)
        return vec2(-1.0);
    return vec2(-b - sqrt(d), -b + sqrt(d));
}

bool view_segment(vec3 origin, vec3 dir, out float tStart, out float tEnd) {
    vec2 atmosphere = ray_sphere(origin, dir, sceneData.skyRadiiScaleHeights.y);
    vec2 ground = ray_sphere(origin, dir, sceneData.skyRadiiScaleHeights.x);
    tStart = max(atmosphere.x, 0.0);
    tEnd = ground.x > 0.0 ? min(atmosphere.y, ground.x) : atmosphere.y;
    return atmosphere.y >= 0.0;
}

// Bilinearly samples integrated density columns from the CPU-built atmosphere LUT.
vec4 sun_air_depth(vec3 origin, vec3 dir) {
    float r = length(origin), mu = dot(origin, dir) / r;
    float x = sqrt(clamp((r - sceneData.skyRadiiScaleHeights.x) /
                             (sceneData.skyRadiiScaleHeights.y - sceneData.skyRadiiScaleHeights.x),
                         0.0, 1.0)) *
              float(LUT_ALT - 1);
    float y = (0.5 + 0.5 * sign(mu) * sqrt(abs(mu))) * float(LUT_MU - 1);
    ivec2 i = min(ivec2(x, y), ivec2(LUT_ALT - 2, LUT_MU - 2));
    vec2 f = vec2(x, y) - vec2(i);
    int k = i.x * LUT_MU + i.y;
    return mix(mix(transmittanceLut.depth[k], transmittanceLut.depth[k + 1], f.y),
               mix(transmittanceLut.depth[k + LUT_MU], transmittanceLut.depth[k + LUT_MU + 1], f.y), f.x);
}

// Applies Beer-Lambert attenuation for one wavelength using all four stored
// density columns and that band's Rayleigh, aerosol, and ozone coefficients.
float band_transmittance(vec4 depth, int band) {
    return exp(-(sceneData.spectralBands[band].x * depth.x + sceneData.mieBands[band].x * depth.y +
                 sceneData.spectralBands[band].w * depth.z + sceneData.mieBands[band].z * depth.w));
}

// Stokes vectors use (I, Q, U, V); these helpers rotate reference frames and
// apply scattering Mueller matrices while preserving physical polarization.
mat4 mueller(float m11, float m12, float m22, float m33, float m34, float m44) {
    return mat4(m11, m12, 0.0, 0.0, m12, m22, 0.0, 0.0, 0.0, 0.0, m33, -m34, 0.0, 0.0, m34, m44);
}

vec4 stokes_make_physical(vec4 s) {
    s.x = max(s.x, 0.0);
    float p = length(s.yzw);
    return p > s.x ? vec4(s.x, s.yzw * s.x / p) : s;
}

void beam_basis(vec3 d, out vec3 a, out vec3 b) {
    vec3 up = abs(d.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    a = normalize(up - d * dot(d, up));
    b = cross(d, a);
}

vec2 rotation(float c, float sn) {
    return vec2(c * c - sn * sn, 2.0 * c * sn);
}
vec4 rotate(vec4 s, vec2 r) {
    return vec4(s.x, s.y * r.x + s.z * r.y, -s.y * r.y + s.z * r.x, s.w);
}
vec4 vec4_reframe(vec4 s, vec3 oldA, vec3 oldB, vec3 newA) {
    return rotate(s, rotation(dot(newA, oldA), dot(newA, oldB)));
}

mat4 rainbow_mueller(float cosTheta, int band) {
    int bins = max(16, int(sceneData.rainbowOptical.z));
    float fbin = acos(clamp(cosTheta, -1.0, 1.0)) / PI * float(bins - 1);
    int i0 = int(fbin);
    int a = band * bins + i0, b = band * bins + min(i0 + 1, bins - 1);
    vec4 e = mix(rainbowMatrixBuffer.entries[a], rainbowMatrixBuffer.entries[b], fbin - float(i0));
    return mueller(e.x, e.y, e.x, e.z, e.w, e.z);
}

mat4 rayleigh_mueller(float cosTheta) {
    float kingDepolarization = sceneData.skyVrtParams.y;
    float kingFactor = (1.0 - kingDepolarization) / (1.0 + 0.5 * kingDepolarization);
    float polarizationFactor = (1.0 - 2.0 * kingDepolarization) / max(1.0 - kingDepolarization, 1.0e-4);
    float mu2 = cosTheta * cosTheta;
    float base = 0.75 * (1.0 + mu2), p33 = 1.5 * cosTheta;
    return mueller(mix(1.0, base, kingFactor), -kingFactor * 0.75 * (1.0 - mu2), kingFactor * base,
                   kingFactor * p33, 0.0, kingFactor * polarizationFactor * p33);
}

void scatter_frame(vec3 din, vec3 dout, float cosTheta, out vec4 rot, out vec4 flip) {
    rot = vec4(1.0, 0.0, 1.0, 0.0);
    flip = vec4(1.0);
    vec3 p = cross(din, dout);
    float pl = length(p);
    if (pl < 1.0e-6) {
        if (cosTheta < 0.0)
            flip = vec4(1.0, 1.0, -1.0, -1.0);
        return;
    }
    p /= pl;
    vec3 ain, bin, aout, bout;
    beam_basis(din, ain, bin);
    beam_basis(dout, aout, bout);
    vec3 inAxis = cross(p, din);
    rot = vec4(rotation(dot(inAxis, ain), dot(inAxis, bin)), rotation(dot(aout, cross(p, dout)), dot(aout, p)));
}

vec4 apply_mueller(mat4 m, vec4 s, vec4 rot, vec4 flip) {
    return rotate(m * rotate(s, rot.xy), rot.zw) * flip;
}

vec4 scatter_rainbow(vec4 sIn, vec3 din, vec3 dout, int band) {
    vec4 rot, flip;
    scatter_frame(din, dout, dot(din, dout), rot, flip);
    return apply_mueller(rainbow_mueller(dot(din, dout), band), sIn, rot, flip);
}

// Cached angular geometry for one scattering event. The bin/fraction pair
// interpolates adjacent rows in the CPU-generated phase lookup tables.
struct ScatterGeom {
    mat4 rayleigh;
    vec4 rot, flip;
    int bin;
    float frac;
};

ScatterGeom scatter_geometry(vec3 din, vec3 dout) {
    ScatterGeom g;
    float cosTheta = clamp(dot(din, dout), -1.0, 1.0);
    g.rayleigh = rayleigh_mueller(cosTheta);
    float fbin = acos(cosTheta) / PI * float(max(2, int(sceneData.skyVrtParams.z)) - 1);
    g.bin = int(floor(fbin));
    g.frac = fbin - float(g.bin);
    scatter_frame(din, dout, cosTheta, g.rot, g.flip);
    return g;
}

mat4 mie_mueller(ScatterGeom g, int aerosol, int band) {
    int bins = max(2, int(sceneData.skyVrtParams.z)), base = (aerosol * SPECTRAL_BANDS + band) * bins;
    vec4 e =
        mix(mieMatrixBuffer.entries[base + g.bin], mieMatrixBuffer.entries[base + min(g.bin + 1, bins - 1)], g.frac);
    return mueller(e.x, e.y, e.x, e.z, e.w, e.z);
}

vec4 scatter_band(ScatterGeom g, vec4 s, vec3 w, int band) {
    mat4 m =
        sceneData.spectralBands[band].x * w.x * g.rayleigh + sceneData.mieBands[band].y * w.y * mie_mueller(g, 0, band);
    m += w.z > 0.0 ? sceneData.mieBands[band].w * w.z * mie_mueller(g, 1, band) : mat4(0.0);
    return apply_mueller(m / (4.0 * PI), s, g.rot, g.flip);
}

// Explicit traversal state for nested scattering orders. A fixed array avoids
// recursive shader calls, which GLSL compute shaders do not support.
struct Level {
    vec3 org, dir, pos;
    vec4 air, camDepth, depth0;
    vec2 dirJitter;
    vec4 distanceRates, distanceWeights;
    float span, start, stepWeight, sampleWeight;
    int stepIndex, sampleIndex;
    uint scramble;
    vec4 result[SPECTRAL_BANDS], angular[SPECTRAL_BANDS];
};
const int STACK = int(SpecializedOrders);
Level S[STACK];
uint gRngIndex, gRngScramble;
vec3 spherical_around(vec3 axis, float theta, float phi) {
    vec3 a, b;
    beam_basis(axis, a, b);
    return normalize(axis * cos(theta) + (a * cos(phi) + b * sin(phi)) * sin(theta));
}

ivec2 cdf_layout(int table) {
    int bins = table < 2 ? max(2, int(sceneData.skyVrtParams.z)) : int(sceneData.rainbowOptical.z);
    return ivec2(bins * (table < 2 ? 2 * SPECTRAL_BANDS + table : SPECTRAL_BANDS), bins);
}

float cdf_at(int table, int i) {
    return table < 2 ? mieMatrixBuffer.entries[i].x : rainbowMatrixBuffer.entries[i].x;
}

// Exact annulus width, evaluated without subtracting nearly equal cosines.
float cdf_cosine_width(int bin, int bins) {
    float halfWidth = 0.5 * PI / float(bins - 1);
    return 2.0 * sin(float(2 * bin + 1) * halfWidth) * sin(halfWidth);
}

float cdf_pdf(int table, float cosTheta) {
    ivec2 info = cdf_layout(table);
    float theta = acos(clamp(cosTheta, -1.0, 1.0));
    int bin = min(int(theta / PI * float(info.y - 1)), info.y - 2);
    return (cdf_at(table, info.x + bin + 1) - cdf_at(table, info.x + bin)) /
           (2.0 * PI * cdf_cosine_width(bin, info.y));
}

vec3 cdf_sample(int table, vec3 axis, float u, float phi) {
    ivec2 info = cdf_layout(table);
    int lo = 0, hi = info.y - 1;
    while (hi - lo > 1) {
        int mid = (lo + hi) / 2;
        if (cdf_at(table, info.x + mid) < u)
            lo = mid;
        else
            hi = mid;
    }
    float c0 = cdf_at(table, info.x + lo), c1 = cdf_at(table, info.x + hi);
    float fraction = clamp((u - c0) / max(c1 - c0, 1e-20), 0.0, 1.0);
    float theta0 = float(lo) * PI / float(info.y - 1);
    float theta1 = float(hi) * PI / float(info.y - 1);
    // Interpolate half-angle squares from the nearer pole to preserve tiny
    // polar offsets in float precision. Both branches invert uniform cosine.
    float theta;
    if (lo * 2 < info.y - 1) {
        float a = sin(0.5 * theta0), b = sin(0.5 * theta1);
        theta = 2.0 * asin(sqrt(mix(a * a, b * b, fraction)));
    } else {
        float a = cos(0.5 * theta0), b = cos(0.5 * theta1);
        theta = PI - 2.0 * asin(sqrt(mix(a * a, b * b, fraction)));
    }
    return spherical_around(axis, theta, phi);
}

// Exponential PDFs on the unit segment. Reverse negative rates so both
// sampling and PDF evaluation avoid overflowing exponentials on descending rays.
float distance_pdf(float t, float rate) {
    float k = abs(rate);
    if (k < 1.0e-3)
        return 1.0;
    return k * exp(-k * (rate < 0.0 ? 1.0 - t : t)) / (1.0 - exp(-k));
}

// Invert the complete mixture, so stratified/low-discrepancy inputs remain
// ordered along the ray instead of jumping at proposal-component boundaries.
float sample_distance(float u, vec4 rates, vec4 weights, out float pdf) {
    vec4 k = abs(rates);
    vec4 mass = 1.0 - exp(-k);
    float lo = 0.0, hi = 1.0, t = u;
    for (int iteration = 0; iteration < 32; ++iteration) {
        float cdf = 0.0;
        pdf = 0.0;
        for (int i = 0; i < 4; ++i) {
            float x = rates[i] < 0.0 ? 1.0 - t : t;
            float e = exp(-k[i] * x);
            float f = k[i] < 1.0e-3 ? x : (1.0 - e) / mass[i];
            cdf += weights[i] * (rates[i] < 0.0 ? 1.0 - f : f);
            pdf += weights[i] * (k[i] < 1.0e-3 ? 1.0 : k[i] * e / mass[i]);
        }
        float error = cdf - u;
        if (abs(error) <= 1.0e-7)
            return t;
        if (error < 0.0)
            lo = t;
        else
            hi = t;
        float next = t - error / pdf;
        t = next > lo && next < hi ? next : 0.5 * (lo + hi);
    }
    pdf = 0.0;
    for (int i = 0; i < 4; ++i)
        pdf += weights[i] * distance_pdf(t, rates[i]);
    return t;
}

// Retain full mixture-PDF compensation and the uniform safety component.
void begin_step(int d, int steps) {
    uint dimension = 2u + 4u * uint(d);
    uint scramble = Hash(S[d].scramble ^ uint(S[d].stepIndex) * 0x9e3779b9u);
    float u = (float(S[d].stepIndex) + SampleFloat(gRngIndex, dimension, scramble)) / float(steps);
    float pdf;
    float t = sample_distance(u, S[d].distanceRates, S[d].distanceWeights, pdf);
    S[d].dirJitter =
        vec2(SampleFloat(gRngIndex, dimension + 1u, scramble), SampleFloat(gRngIndex, dimension + 2u, scramble));
    S[d].stepWeight = S[d].span / (float(steps) * pdf);
    S[d].pos = S[d].org + S[d].dir * (S[d].start + t * S[d].span);
    S[d].air = air_density(S[d].pos);
    S[d].camDepth = max(S[d].depth0 - sun_air_depth(S[d].pos, S[d].dir), vec4(0.0));
    for (int b = 0; b < SPECTRAL_BANDS; ++b)
        S[d].angular[b] = vec4(0.0);
    S[d].sampleIndex = 0;
}

vec4 level_value(bool leaf, ScatterGeom g, int d, int b) {
    if (leaf)
        return stokes_make_physical(scatter_band(g, vec4(1.0, 0.0, 0.0, 0.0), S[d].result[b].xyz, b));
    return stokes_make_physical(S[d].result[b]);
}

// Integrates one atmospheric scattering order. Nested levels represent the
// incoming radiance at each collision; phase proposals mix sun/view directions
// and Mie lobes, with PDF compensation in sampleWeight.
void scatter_order(vec3 origin, vec3 viewDir, vec3 L, int order, int viewSteps, int samples, int secondarySteps,
                   inout vec4 sky[SPECTRAL_BANDS]) {
    int last = clamp(order, 1, STACK) - 1, d = 0;
    S[0].org = origin;
    S[0].dir = viewDir;
    S[0].scramble = gRngScramble;
    bool entering = true;
    while (true) {
        int steps = d == 0 ? viewSteps : secondarySteps;
        if (entering) {
            entering = false;
            float tEnd;
            if (!view_segment(S[d].org, S[d].dir, S[d].start, tEnd)) {
                if (d-- == 0)
                    return;
                ++S[d].sampleIndex;
                continue;
            }
            vec3 first = S[d].org + S[d].dir * S[d].start;
            S[d].span = max(tEnd - S[d].start, 1.0e-3);
            S[d].depth0 = sun_air_depth(first, S[d].dir);
            vec4 total = max(S[d].depth0 - sun_air_depth(first + S[d].dir * S[d].span, S[d].dir), vec4(0.0));
            float tau = sceneData.spectralBands[6].x * total.x + sceneData.mieBands[6].x * total.y +
                        sceneData.mieBands[6].z * total.w;
            float altitudeChange = length(first + S[d].dir * S[d].span) - length(first);
            vec3 scaleHeights = vec3(sceneData.skyRadiiScaleHeights.zw, sceneData.skyVrtParams.w);
            S[d].distanceRates = vec4(0.0, clamp(vec3(clamp(tau, 0.0, 8.0)) + altitudeChange / scaleHeights,
                                                vec3(-32.0), vec3(32.0)));
            if (dot(first, S[d].dir) < 0.0 && dot(first, S[d].dir) + S[d].span > 0.0)
                S[d].distanceRates = vec4(clamp(tau, 0.0, 8.0));
            vec3 scattering = max(total.xyw * vec3(sceneData.spectralBands[6].x,
                                                  sceneData.mieBands[6].y, sceneData.mieBands[6].w), vec3(0.0));
            float scatteringSum = dot(scattering, vec3(1.0));
            S[d].distanceWeights = scatteringSum > 1.0e-30
                                       ? vec4(0.1, 0.9 * scattering / scatteringSum)
                                       : vec4(1.0, 0.0, 0.0, 0.0);
            for (int b = 0; b < SPECTRAL_BANDS; ++b)
                S[d].result[b] = vec4(0.0);
            S[d].stepIndex = 0;
            begin_step(d, steps);
        }
        if (d < last && S[d].sampleIndex < samples) {
            float u = (float(S[d].sampleIndex) + S[d].dirJitter.x) / float(samples);
            float phi = GOLDEN_ANGLE * float(S[d].sampleIndex + S[d].stepIndex * samples) + 2.0 * PI * S[d].dirJitter.y;
            S[d + 1].org = S[d].pos;
            vec3 next;
            vec3 current = S[d].dir;
            vec3 strength = max(S[d].air.xyw * vec3(sceneData.spectralBands[6].x,
                                                   sceneData.mieBands[6].y, sceneData.mieBands[6].w), vec3(0.0));
            vec3 weights = 0.8 * strength / max(dot(strength, vec3(1.0)), 1.0e-30);
            float fine = 0.5 * weights.y, coarse = 0.5 * weights.z;
            float uniformWeight = 1.0 - dot(weights, vec3(1.0));
            float masses[6] = float[6](fine, coarse, fine, coarse, weights.x, uniformWeight);
            float lower = 0.0;
            int component = 5;
            for (int i = 0; i < 5; ++i) {
                if (u < lower + masses[i]) {
                    component = i;
                    break;
                }
                lower += masses[i];
            }
            u = clamp((u - lower) / masses[component], 0.0, 1.0);
            if (component < 4)
                next = cdf_sample(component % 2, component < 2 ? L : current, u, phi);
            else if (component == 4) {
                float mu = 2.0 * sinh(asinh(4.0 * u - 2.0) / 3.0);
                next = spherical_around(current, acos(clamp(mu, -1.0, 1.0)), phi);
            } else
                next = spherical_around(current, acos(1.0 - 2.0 * u), phi);
            float cosSun = dot(next, L), cosCurrent = dot(next, current);
            float pdf = (uniformWeight + weights.x * 0.75 * (1.0 + cosCurrent * cosCurrent)) / (4.0 * PI) +
                        fine * (cdf_pdf(0, cosSun) + cdf_pdf(0, cosCurrent));
            pdf += coarse > 0.0 ? coarse * (cdf_pdf(1, cosSun) + cdf_pdf(1, cosCurrent)) : 0.0;
            S[d].sampleWeight = 1.0 / (pdf * float(samples));
            S[d + 1].scramble = Hash(S[d].scramble ^ uint(S[d].stepIndex) * 0x9e3779b9u ^
                                    uint(S[d].sampleIndex) * 0x68bc21ebu ^ 0xa511e9b3u);
            S[++d].dir = next;
            entering = true;
            continue;
        }
        vec4 midDepth = S[d].camDepth;
        if (d < last) {
            for (int b = 0; b < SPECTRAL_BANDS; ++b)
                S[d].result[b] += S[d].angular[b] * (band_transmittance(midDepth, b) * S[d].stepWeight);
        } else if (ray_sphere(S[d].pos, L, sceneData.skyRadiiScaleHeights.x).x <= 0.0) {
            vec4 depth = sun_air_depth(S[d].pos, L);
            for (int b = 0; b < SPECTRAL_BANDS; ++b)
                S[d].result[b].xyz +=
                    S[d].air.xyw * (band_transmittance(midDepth, b) * S[d].stepWeight * sceneData.spectralBands[b].y *
                                    sceneData.sunDisk.x * band_transmittance(depth, b));
        }
        if (++S[d].stepIndex < steps) {
            begin_step(d, steps);
            continue;
        }
        bool leaf = d == last;
        ScatterGeom sunGeom;
        if (leaf)
            sunGeom = scatter_geometry(-L, -S[d].dir);
        int child = d;
        if (d-- == 0) {
            for (int b = 0; b < SPECTRAL_BANDS; ++b)
                sky[b] += level_value(leaf, sunGeom, child, b);
            return;
        }
        ScatterGeom g = scatter_geometry(-S[child].dir, -S[d].dir);
        for (int b = 0; b < SPECTRAL_BANDS; ++b)
            S[d].angular[b] +=
                scatter_band(g, level_value(leaf, sunGeom, child, b), S[d].air.xyw, b) * S[d].sampleWeight;
        ++S[d].sampleIndex;
    }
}

// Combines atmospheric scattering with the finite solar disk and its limb
// profile. Rays that hit the ground stop at first order to avoid sky sampling
// through the planet.
vec4[SPECTRAL_BANDS] render_sky(vec3 viewDir, vec3 L) {
    vec3 origin = vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0);
    vec4 sky[SPECTRAL_BANDS];
    for (int b = 0; b < SPECTRAL_BANDS; ++b)
        sky[b] = vec4(0.0);
    float groundT = ray_sphere(origin, viewDir, sceneData.skyRadiiScaleHeights.x).x;
    int orders = groundT > 0.0 ? 1 : int(SpecializedOrders);
    uint orderScramble = gRngScramble;
    for (int order = 1; order <= orders; ++order) {
        gRngScramble = Hash(orderScramble ^ uint(order) * 0x68bc21ebu);
        scatter_order(origin, viewDir, L, order, int(SpecializedViewSteps), int(SpecializedSamples),
                      int(SpecializedSecondarySamples), sky);
    }
    vec3 apparent = sceneData.apparentSun.xyz;
    vec3 vertical = normalize(vec3(0.0, 1.0, 0.0) - apparent * apparent.y);
    vec2 offset = vec2(dot(viewDir, cross(vertical, apparent)), dot(viewDir, vertical) / sceneData.apparentSun.w);
    float r = dot(viewDir, apparent) > 0.0 ? length(offset) : 1.0;
    float disk = 1.0 - smoothstep(sceneData.skySunDirectionRadius.w - sceneData.skyVrtParams.x,
                                  sceneData.skySunDirectionRadius.w + sceneData.skyVrtParams.x, r);
    float limbMu =
        sqrt(max(0.0, 1.0 - r * r / (sceneData.skySunDirectionRadius.w * sceneData.skySunDirectionRadius.w)));
    vec4 depth = sun_air_depth(origin, viewDir);
    bool sunVisible = disk > 0.0 && groundT <= 0.0;
    vec3 solarRadial = cross(vertical, apparent) * offset.x + vertical * offset.y * sceneData.apparentSun.w;
    float radialLength = length(solarRadial);
    vec3 sunA, sunB;
    beam_basis(-viewDir, sunA, sunB);
    float cos2Limb = 0.0, sin2Limb = 0.0;
    if (radialLength > 1.0e-8) {
        vec3 limbTangent = cross(apparent, solarRadial / radialLength);
        float tangentA = dot(limbTangent, sunA), tangentB = dot(limbTangent, sunB);
        float tangentNorm = max(tangentA * tangentA + tangentB * tangentB, 1.0e-12);
        cos2Limb = (tangentA * tangentA - tangentB * tangentB) / tangentNorm;
        sin2Limb = 2.0 * tangentA * tangentB / tangentNorm;
    }
    for (int b = 0; b < SPECTRAL_BANDS; ++b) {
        float wavelengthNm = sceneData.spectralBands[b].z;
        float limbIntensity = solar_limb_intensity(limbMu, wavelengthNm);
        float limbPolarization = solar_limb_polarization(limbMu, wavelengthNm, limbIntensity);
        float intensity =
            sunVisible ? disk * sceneData.spectralBands[b].y * limbIntensity * band_transmittance(depth, b) : 0.0;
        sky[b] += intensity * vec4(1.0, limbPolarization * cos2Limb, limbPolarization * sin2Limb, 0.0);
        sky[b] = stokes_make_physical(sky[b]);
    }
    return sky;
}

vec2 ray_ellipsoid(vec3 origin, vec3 dir) {
    vec3 o = rain_frame(origin - sceneData.rainbowCenterEnabled.xyz);
    vec3 d = rain_frame(dir);
    float a = dot(d, d), b = dot(o, d), c = dot(o, o) - 1.0;
    float discriminant = b * b - a * c;
    if (discriminant < 0.0)
        return vec2(-1.0);
    return vec2(-b - sqrt(discriminant), -b + sqrt(discriminant)) / a;
}

float rainbow_density(vec3 localPosition) {
    float q = length(rain_frame(localPosition - sceneData.rainbowCenterEnabled.xyz));
    float softness = sceneData.rainbowRadiiEdge.w;
    if (softness <= 0.0)
        return q <= 1.0 ? 1.0 : 0.0;
    return 1.0 - smoothstep(1.0 - softness, 1.0, q);
}

// q(t) = normalized ellipsoid radius along the transformed ray.
float rain_q(float t, float a, float b, float c) {
    return sqrt(max(a * t * t + 2.0 * b * t + c, 0.0));
}

// J1(t) = integral of q(t) dt.
float rain_J1(float t, float a, float b, float c) {
    float q = rain_q(t, a, b, c);
    float delta = max(a * c - b * b, 0.0);
    float result = 0.5 * (t + b / a) * q;
    if (delta > 0.0)
        result += 0.5 * delta / (a * sqrt(a)) * asinh((a * t + b) / sqrt(delta));
    return result;
}

// J2(t) = integral of q(t)^2 dt.
float rain_J2(float t, float a, float b, float c) {
    return (a / 3.0) * t * t * t + b * t * t + c * t;
}

// J3(t) = integral of q(t)^3 dt.
float rain_J3(float t, float a, float b, float c) {
    float q = rain_q(t, a, b, c);
    float delta = max(a * c - b * b, 0.0);
    return (a * t + b) * q * q * q / (4.0 * a) + 3.0 * delta * rain_J1(t, a, b, c) / (4.0 * a);
}

float rain_soft_interval(float lo, float hi, float a, float b, float c, float inner, float softness) {
    if (hi <= lo)
        return 0.0;

    float dt = hi - lo;
    float dJ1 = rain_J1(hi, a, b, c) - rain_J1(lo, a, b, c);
    float dJ2 = rain_J2(hi, a, b, c) - rain_J2(lo, a, b, c);
    float dJ3 = rain_J3(hi, a, b, c) - rain_J3(lo, a, b, c);

    float inner2 = inner * inner;
    float inner3 = inner2 * inner;
    float shifted2 = dJ2 - 2.0 * inner * dJ1 + inner2 * dt;
    float shifted3 = dJ3 - 3.0 * inner * dJ2 + 3.0 * inner2 * dJ1 - inner3 * dt;
    float s2 = softness * softness;
    float s3 = s2 * softness;

    return clamp(dt - 3.0 * shifted2 / s2 + 2.0 * shifted3 / s3, 0.0, dt);
}


// Integrates the soft ellipsoid density analytically along a ray interval.
float rain_segment_tau(vec3 origin, vec3 direction, float start, float end) {
    if (end <= start)
        return 0.0;

    float extinction = sceneData.rainbowOptical.y;
    float softness = sceneData.rainbowRadiiEdge.w;
    if (softness <= 0.0)
        return extinction * (end - start);

    vec3 o = rain_frame(origin - sceneData.rainbowCenterEnabled.xyz);
    vec3 d = rain_frame(direction);
    float a = dot(d, d);
    float b = dot(o, d);
    float c = dot(o, o);
    if (a <= 0.0)
        return 0.0;

    float outerDisc = b * b - a * c + a;
    if (outerDisc <= 0.0)
        return 0.0;

    float outerRoot = sqrt(max(outerDisc, 0.0));
    float outerNear = (-b - outerRoot) / a;
    float outerFar  = (-b + outerRoot) / a;
    float outerLo = max(start, outerNear);
    float outerHi = min(end, outerFar);
    if (outerHi <= outerLo)
        return 0.0;

    float inner = 1.0 - softness;
    if (inner <= 0.0) {
        float integral = rain_soft_interval(outerLo, outerHi, a, b, c, inner, softness);
        return extinction * max(integral, 0.0);
    }

    float innerDisc = b * b - a * c + a * inner * inner;
    if (innerDisc <= 0.0)
        return extinction * max(rain_soft_interval(outerLo, outerHi, a, b, c, inner, softness), 0.0);

    float innerRoot = sqrt(max(innerDisc, 0.0));
    float innerNear = (-b - innerRoot) / a;
    float innerFar  = (-b + innerRoot) / a;

    float integral = 0.0;
    float leftLo = outerLo;
    float leftHi = min(outerHi, innerNear);
    if (leftHi > leftLo)
        integral += rain_soft_interval(leftLo, leftHi, a, b, c, inner, softness);

    float coreLo = max(outerLo, innerNear);
    float coreHi = min(outerHi, innerFar);
    if (coreHi > coreLo)
        integral += coreHi - coreLo;

    float rightLo = max(outerLo, innerFar);
    float rightHi = outerHi;
    if (rightHi > rightLo)
        integral += rain_soft_interval(rightLo, rightHi, a, b, c, inner, softness);

    return extinction * max(integral, 0.0);
}

vec2 rain_segment(vec3 origin, vec3 direction) {
    vec2 hit = ray_ellipsoid(origin, direction);
    hit.x = max(hit.x, 0.0);
    float ground = ray_sphere(origin + vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0),
                              direction, sceneData.skyRadiiScaleHeights.x).x;
    hit.y = ground > 0.0 ? min(hit.y, ground) : hit.y;
    return hit;
}

float rain_direction_pdf(float cosTheta) {
    return 0.9 * cdf_pdf(2, cosTheta) + 0.1 / (4.0 * PI);
}

vec3 rain_sample_direction(vec3 axis, inout uint index, inout uint dimension, uint scramble) {
    float branch = NextFloat(index, dimension, scramble), u = NextFloat(index, dimension, scramble),
          phi = 2.0 * PI * NextFloat(index, dimension, scramble);
    if (branch < 0.9)
        return cdf_sample(2, axis, u, phi);
    return spherical_around(axis, acos(1.0 - 2.0 * u), phi);
}

// Estimates rain-volume radiance with free-flight distance sampling and a
// mixture proposal for successive scattering directions. Throughput includes
// proposal-PDF compensation and attenuation through the rain and atmosphere.
vec4[SPECTRAL_BANDS] integrate_rainbow(vec3 viewDir, vec3 sun, uint index, uint scramble) {
    vec4 result[SPECTRAL_BANDS];
    for (int b = 0; b < SPECTRAL_BANDS; ++b)
        result[b] = vec4(0.0);
    int orders = clamp(int(sceneData.rainbowMultiple.x), 1, MAX_SCATTER_ORDER);
    int samples = max(1, int(sceneData.rainbowMultiple.y));
    if (!(SpecializedRainbow && sceneData.rainbowCenterEnabled.w > 0.5 && sceneData.rainbowOptical.x > 0.0))
        return result;
    float extinction = sceneData.rainbowOptical.y;
    for (int sampleIndex = 0; sampleIndex < samples; ++sampleIndex) {
        // Consecutive camera samples own disjoint blocks of rain paths.
        // Keep the scramble fixed across the block to retain stratification.
        uint sobolIndex = NestedUniformScramble(index * uint(samples) + uint(sampleIndex),
                                               Hash(scramble ^ 0xa511e9b3u));
        uint dimension = 2u;
        vec3 origin = vec3(0.0), direction = viewDir, pathDirections[MAX_SCATTER_ORDER];
        float throughput = 1.0;
        vec4 airPath = vec4(0.0);
        for (int vertex = 0; vertex < orders; ++vertex) {
            vec2 hit = rain_segment(origin, direction);
            float lengthInRain = hit.y - hit.x;
            if (lengthInRain <= 0.0)
                break;
            float tau = extinction * lengthInRain;
            float mass = tau < 0.001 ? tau * (1.0 - 0.5 * tau + tau * tau / 6.0) : 1.0 - exp(-tau);
            float u =
                SampleFloat(sobolIndex, dimension++, scramble ^ uint(vertex) * 0x68bc21ebu);
            float distance = tau < 0.001 ? u * lengthInRain : -log(1.0 - u * mass) / extinction;
            float pdf = tau < 0.001 ? 1.0 / lengthInRain : extinction * exp(-extinction * distance) / mass;
            vec3 p = origin + direction * (hit.x + distance);
            float density = rainbow_density(p);
            if (density <= 0.0)
                break;
            throughput *= sceneData.rainbowOptical.x * density *
                          exp(-rain_segment_tau(origin, direction, hit.x, hit.x + distance)) / pdf;
            pathDirections[vertex] = direction;
            vec3 earth = p + vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0);
            airPath += max(sun_air_depth(origin + vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0), direction) -
                               sun_air_depth(earth, direction),
                           vec4(0.0));
            if (ray_sphere(earth, sun, sceneData.skyRadiiScaleHeights.x).x <= 0.0) {
                vec4 air = sun_air_depth(earth, sun) + airPath;
                float sunT = exp(-rain_segment_tau(p, sun, 0.0, max(rain_segment(p, sun).y, 0.0)));
                for (int band = 0; band < SPECTRAL_BANDS; ++band) {
                    vec4 s = scatter_rainbow(vec4(1.0, 0.0, 0.0, 0.0), -sun, -direction, band) / (4.0 * PI);
                    for (int previous = vertex - 1; previous >= 0; --previous)
                        s = scatter_rainbow(s, -pathDirections[previous + 1], -pathDirections[previous], band) /
                            (4.0 * PI);
                    result[band] += s * (throughput * sceneData.sunDisk.x * sunT * band_transmittance(air, band) *
                                         sceneData.spectralBands[band].y / float(samples));
                }
            }
            if (vertex + 1 < orders) {
                vec3 next = NextFloat(sobolIndex, dimension, scramble) < 0.5
                                ? -rain_sample_direction(-direction, sobolIndex, dimension, scramble)
                                : rain_sample_direction(sun, sobolIndex, dimension, scramble);
                throughput /= 0.5 * (rain_direction_pdf(dot(next, direction)) + rain_direction_pdf(dot(next, sun)));
                origin = p;
                direction = next;
            }
        }
    }
    return result;
}

// For each pixel: generate jittered camera rays, evaluate sky/rain/stars in
// spectral Stokes form, project through the optional analyzer, accumulate XYZ,
// then convert to display RGB with exposure and the AgX/sRGB output transform.
void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.imageSize.x || pixel.y >= pc.imageSize.y)
        return;
    uint pixelSeed = Hash(pixel.x + pixel.y * 9781u), frameSampleBase = uint(pc.frame.x) * uint(max(1.0, pc.forward.w));
    uint rngScramble = pixelSeed ^ 0x5bd1e995u;

    uint samplesPerPixel = uint(pc.forward.w);
    bool polarized = pc.polarizer.x > 0.5;
    float linAmp = cos(2.0 * pc.polarizer.z);
    vec4 analyzer =
        vec4(1.0, linAmp * cos(2.0 * pc.polarizer.y), linAmp * sin(2.0 * pc.polarizer.y), sin(2.0 * pc.polarizer.z));
    vec3 sun = normalize(sceneData.skySunDirectionRadius.xyz);

    vec3 accumulatedXyz = vec3(0.0);
    for (uint localSample = 0; localSample < samplesPerPixel; ++localSample) {
        uint sampleNumber = frameSampleBase + localSample;
        uint shuffledIndex = NestedUniformScramble(sampleNumber, Hash(pixelSeed ^ 0xa511e9b3u));
        vec2 jitter = vec2(SampleFloat(shuffledIndex, 0u, pixelSeed), SampleFloat(shuffledIndex, 1u, pixelSeed));
        vec2 uv = (vec2(pixel) + jitter) / vec2(pc.imageSize);
        vec2 screen = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
        vec3 viewDir = normalize(pc.forward.xyz + pc.right.xyz * screen.x + pc.up.xyz * screen.y);
        vec3 frameX = normalize(pc.right.xyz - viewDir * dot(pc.right.xyz, viewDir)), na, nb;
        beam_basis(-viewDir, na, nb);
        vec4 rainbow[SPECTRAL_BANDS];
        for (int b = 0; b < SPECTRAL_BANDS; ++b)
            rainbow[b] = vec4(0.0);
        vec2 rainHit =
            (SpecializedRainbow && sceneData.rainbowCenterEnabled.w > 0.5 && sceneData.rainbowOptical.x > 0.0)
                ? rain_segment(vec3(0.0), viewDir)
                : vec2(0.0);
        if (subgroupAny(rainHit.y > rainHit.x)) {
            rainbow = integrate_rainbow(viewDir, sun, sampleNumber, pixelSeed);
        }
        gRngIndex = shuffledIndex;
        gRngScramble = rngScramble;
        vec4 sky[SPECTRAL_BANDS] = render_sky(viewDir, sun);
        float night = 1.0 - smoothstep(-0.18, -0.02, sun.y);
        if (night > 0.0 && ray_sphere(vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0), viewDir,
                                      sceneData.skyRadiiScaleHeights.x)
                                   .x <= 0.0) {
            vec4 star = procedural_star(viewDir);
            if (star.x > 0.0) {
                vec4 starDepth = sun_air_depth(vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0), viewDir);
                for (int band = 0; band < SPECTRAL_BANDS; ++band) {
                    float wavelengthNm = sceneData.spectralBands[band].z;
                    sky[band].x +=
                        night * star.x * stellar_spectrum(wavelengthNm, star.y) * band_transmittance(starDepth, band);
                }
            }
        }

        vec3 sampleXyz = vec3(0.0);
        for (int band = 0; band < SPECTRAL_BANDS; ++band) {
            vec4 total = sky[band] + rainbow[band];
            float radiance = polarized ? 0.5 * dot(analyzer, vec4_reframe(total, na, nb, frameX)) : total.x;
            sampleXyz += max(radiance, 0.0) * sceneData.cieXyz[band].xyz;
        }
        accumulatedXyz += sampleXyz;
    }
    vec3 xyz = accumulatedXyz / float(max(1u, samplesPerPixel));
    uint index = pixel.y * pc.imageSize.x + pixel.x;
    vec4 previous = pc.frame.z > 0.5 ? vec4(0.0) : accumulation.pixels[index];
    xyz = previous.xyz + (xyz - previous.xyz) / (previous.w + 1.0);
    accumulation.pixels[index] = vec4(xyz, previous.w + 1.0);
    vec3 rgb = mat3(3.2406, -0.9689, 0.0557, -1.5372, 1.8758, -0.2040, -0.4986, 0.0415, 1.0570) * xyz;
    float lowest = min(rgb.r, min(rgb.g, rgb.b));
    rgb = lowest < 0.0 && xyz.y > 0.0 ? xyz.y + (rgb - xyz.y) * (xyz.y / (xyz.y - lowest)) : rgb;
    rgb = max(rgb, vec3(0.0)) * pc.frame.y;

    const mat3 agxInset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051, 0.0784335999999992,
                               0.878468636469772, 0.0784336, 0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 agxOutset =
        mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438, -0.0980208811401368, 1.15190312990417,
             -0.0980434501171241, -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    vec3 x = (clamp(log2(max(agxInset * rgb, vec3(1.0e-10))), -12.47393, 4.026069) + 12.47393) / 16.499999;
    vec3 x2 = x * x, x4 = x2 * x2;
    x = 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
    vec3 c = min(pow(max(agxOutset * x, vec3(0.0)), vec3(2.2)), 1.0);
    imageStore(outputImage, ivec2(pixel),
               vec4(mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, 12.92 * c, lessThanEqual(c, vec3(0.0031308))), 1.0));
}
