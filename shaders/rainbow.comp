// Finite rain volume and spherical droplet Mueller table.
// All scattering orders are evaluated by the shared transport solver.

#ifndef RAINBOW_COMP_INCLUDED
#define RAINBOW_COMP_INCLUDED

vec3 RainbowCenter() { return sceneData.rainbowCenterEnabled.xyz; }
bool RainbowEnabled() { return sceneData.rainbowCenterEnabled.w > 0.5; }
vec3 RainbowRadii() { return sceneData.rainbowRadiiEdge.xyz; }
float RainbowEdgeSoftness() { return sceneData.rainbowRadiiEdge.w; }
float RainbowScattering() { return sceneData.rainbowOptical.x; }
float RainbowExtinction() { return sceneData.rainbowOptical.y; }
int RainbowAngleBins() { return int(sceneData.rainbowOptical.z); }
int RainbowViewSteps() { return int(sceneData.rainbowSampleCounts.x); }
int RainbowScatteringOrders() { return int(sceneData.rainbowSampleCounts.y); }

vec2 ray_ellipsoid(vec3 origin, vec3 dir)
{
    vec3 invR = 1.0 / RainbowRadii();
    vec3 o = (origin - RainbowCenter()) * invR;
    vec3 d = dir * invR;
    float a = dot(d, d);
    float b = dot(o, d);
    float c = dot(o, o) - 1.0;
    float discriminant = b * b - a * c;
    if (discriminant < 0.0) return vec2(-1.0);
    float root = sqrt(discriminant);
    return vec2((-b - root) / a, (-b + root) / a);
}

float rainbow_density(vec3 localPosition)
{
    float q = length((localPosition - RainbowCenter()) / RainbowRadii());
    float softness = RainbowEdgeSoftness();
    if (softness <= 0.0) return q <= 1.0 ? 1.0 : 0.0;
    return 1.0 - smoothstep(1.0 - softness, 1.0, q);
}

Mueller rainbow_mueller(float cosTheta, int band)
{
    int bins = max(16, RainbowAngleBins());
    float fbin = acos(clamp(cosTheta, -1.0, 1.0)) / PI * float(bins - 1);
    int i0 = clamp(int(floor(fbin)), 0, bins - 1);
    int i1 = min(i0 + 1, bins - 1);
    RainbowMatrixEntry e0 = rainbowMatrixBuffer.entries[band * bins + i0];
    RainbowMatrixEntry e1 = rainbowMatrixBuffer.entries[band * bins + i1];
    vec4 a = mix(e0.a, e1.a, fbin - float(i0));
    vec4 b = mix(e0.b, e1.b, fbin - float(i0));
    Mueller m;
    m.m11 = a.x;
    m.m12 = a.y;
    m.m22 = a.z;
    m.m33 = a.w;
    m.m34 = b.x;
    m.m44 = b.y;
    return m;
}

Stokes scatter_rainbow(Stokes incoming, vec3 din, vec3 dout, int band)
{
    float cosTheta = clamp(dot(din, dout), -1.0, 1.0);
    Mueller m = rainbow_mueller(cosTheta, band);
    vec3 ain; vec3 bin; beam_basis(din, ain, bin);
    vec3 aout; vec3 bout; beam_basis(dout, aout, bout);
    vec3 normal = cross(din, dout);
    float normalLength = length(normal);
    if (normalLength < 1.0e-6)
    {
        Stokes result = mueller_apply(m, incoming);
        if (cosTheta < 0.0) { result.U = -result.U; result.V = -result.V; }
        return result;
    }
    normal /= normalLength;
    vec3 inAxis = cross(normal, din);
    vec3 outAxis = cross(normal, dout);
    Stokes result = stokes_reframe(incoming, ain, bin, inAxis, normal);
    result = mueller_apply(m, result);
    return stokes_reframe(result, outAxis, normal, aout, bout);
}


#endif
