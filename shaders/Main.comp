/// @file Main.comp
/// @brief Vulkan compute shader that renders and accumulates a sky path.
///
/// The shader accumulates Stokes radiance and writes a tone-mapped output image.
#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/// Storage image written by this workgroup's pixel invocation.
layout(set = 0, binding = 0) uniform writeonly image2D outputImage;
layout(set = 0, binding = 1) uniform SceneData {
	vec4 skyParams, skySunDirectionRadius;
	vec4 rayleigh, sunParams;
}
sceneData; ///< Scene uniforms shared by the host and compute shader.

layout(std430, set = 0, binding = 2) readonly buffer TransmittanceBuffer { float depth[]; }
transmittanceLut; ///< Preintegrated Rayleigh density columns.
layout(std430, set = 0, binding = 3) buffer AccumulationBuffer { vec4 pixels[]; }
accumulation; ///< Per-pixel running averages and sample counts.

layout(push_constant) uniform PushConstants {
	vec4 forward, right, up, frame, polarizer;
	uvec2 imageSize;
}
pc; ///< Per-dispatch camera, exposure, polarization, and image data.

const float PI = 3.14159265358979323846; ///< Pi in radians.
const int LUT_ALT = 64; ///< Number of altitude samples in the transmittance table.
const int LUT_MU = 256; ///< Number of direction cosine samples in each transmittance row.

vec3 gRayleighCoefficient; ///< Rayleigh scattering coefficient for each color channel.

/// Converts the high 23 bits of an integer to a floating point variate in (0, 1).
/// @param x Integer random value.
/// @return Floating point variate in (0, 1).
float ToUnit(uint x) { return (float(x >> 9u) + 0.5) * (1.0 / 8388608.0); }

/// Mixes the bits of an integer to produce a deterministic pseudorandom value.
/// @param x Input integer.
/// @return Hashed integer.
uint Hash(uint x) {
	x = x * 747796405u + 2891336453u;
	x = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
	return (x >> 22u) ^ x;
}

