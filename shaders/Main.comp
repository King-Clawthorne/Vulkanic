uint NestedUniformScramble(uint value, uint seed) {
    value = bitfieldReverse(value);
    value ^= value * 0x3d20adeau;
    value += seed;
    value *= (seed >> 16u) | 1u;
    value ^= value * 0x05526c56u;
    value ^= value * 0x53a22864u;
    return bitfieldReverse(value);
}

float SampleFloat(uint index, uint dimension, uint scramble) {
    uint seed = Hash(scramble ^ (dimension * 0x9e3779b9u));
    if (dimension >= SAMPLE_DIMENSIONS) return ToUnit(Hash(index ^ seed));

    uint value = 0u;
    while (index != 0u) {
        value ^= SOBOL_DIRECTIONS[dimension * 32u + uint(findLSB(index))];
        index &= index - 1u;
    }

    return ToUnit(NestedUniformScramble(value, seed));
}

vec4 air_density(vec3 pos) {
    float h = max(length(pos) - sceneData.skyRadiiScaleHeights.x, 0.0);
    return vec4(exp(-h / sceneData.skyRadiiScaleHeights.zw), 0.0, exp(-h / sceneData.skyVrtParams.w));
}

vec2 ray_sphere(vec3 origin, vec3 dir, float radius) {
    float b = dot(origin, dir);
    float d = b * b - dot(origin, origin) + radius * radius;
    if (d < 0.0) return vec2(-1.0);
    return vec2(-b - sqrt(d), -b + sqrt(d));
}

bool view_segment(vec3 origin, vec3 dir, out float tStart, out float tEnd) {
    vec2 atmosphere = ray_sphere(origin, dir, sceneData.skyRadiiScaleHeights.y);
    vec2 ground = ray_sphere(origin, dir, sceneData.skyRadiiScaleHeights.x);
    tStart = max(atmosphere.x, 0.0);

    tEnd = ground.x > 0.0 ? min(atmosphere.y, ground.x) : atmosphere.y;
    return atmosphere.y >= 0.0;
}

vec4 sun_air_depth(vec3 origin, vec3 dir) {
    float r = length(origin), mu = dot(origin, dir) / r;
    float x = sqrt(clamp((r - sceneData.skyRadiiScaleHeights.x) / (sceneData.skyRadiiScaleHeights.y - sceneData.skyRadiiScaleHeights.x), 0.0, 1.0)) * float(LUT_ALT - 1);
    float y = (0.5 + 0.5 * sign(mu) * sqrt(abs(mu))) * float(LUT_MU - 1);
    ivec2 i = min(ivec2(x, y), ivec2(LUT_ALT - 2, LUT_MU - 2));
    vec2 f = vec2(x, y) - vec2(i);
    int k = i.x * LUT_MU + i.y;

    return mix(mix(transmittanceLut.depth[k], transmittanceLut.depth[k + 1], f.y), mix(transmittanceLut.depth[k + LUT_MU], transmittanceLut.depth[k + LUT_MU + 1], f.y), f.x);
}

float wavelength_transmittance(vec4 depth) { return exp(-(gSpectralBand.x * depth.x + gMieBand.x * depth.y + gMieBand.z * depth.w)); }
mat4 mueller(float m11, float m12, float m22, float m33, float m34, float m44) { return mat4(m11, m12, 0.0, 0.0, m12, m22, 0.0, 0.0, 0.0, 0.0, m33, -m34, 0.0, 0.0, m34, m44); }

vec4 stokes_make_physical(vec4 s) {
    s.x = max(s.x, 0.0);
    float p = length(s.yzw);
    return p > s.x ? vec4(s.x, s.yzw * s.x / p) : s;
}

void beam_basis(vec3 d, out vec3 a, out vec3 b) {
    vec3 up = abs(d.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    a = normalize(up - d * dot(d, up));
    b = cross(d, a);
}

vec2 rotation(float c, float sn) { return vec2(c * c - sn * sn, 2.0 * c * sn); }
vec4 rotate(vec4 s, vec2 r) { return vec4(s.x, s.y * r.x + s.z * r.y, -s.y * r.y + s.z * r.x, s.w); }
vec4 vec4_reframe(vec4 s, vec3 oldA, vec3 oldB, vec3 newA) { return rotate(s, rotation(dot(newA, oldA), dot(newA, oldB))); }

mat4 rayleigh_mueller(float cosTheta) {
    float kingDepolarization = sceneData.skyVrtParams.y;
    float kingFactor = (1.0 - kingDepolarization) / (1.0 + 0.5 * kingDepolarization);
    float polarizationFactor = (1.0 - 2.0 * kingDepolarization) / max(1.0 - kingDepolarization, 1.0e-4);
    float mu2 = cosTheta * cosTheta;
    float base = 0.75 * (1.0 + mu2), p33 = 1.5 * cosTheta;
    return mueller(mix(1.0, base, kingFactor), -kingFactor * 0.75 * (1.0 - mu2), kingFactor * base, kingFactor * p33, 0.0, kingFactor * polarizationFactor * p33);
}

void scatter_frame(vec3 din, vec3 dout, float cosTheta, out vec4 rot, out vec4 flip) {
    rot = vec4(1.0, 0.0, 1.0, 0.0);
    flip = vec4(1.0);
    vec3 p = cross(din, dout);
    float pl = length(p);

    if (pl < 1.0e-6) {
        if (cosTheta < 0.0) flip = vec4(1.0, 1.0, -1.0, -1.0);
        return;
    }

    p /= pl;
    vec3 ain, bin, aout, bout;
    beam_basis(din, ain, bin);
    beam_basis(dout, aout, bout);
    vec3 inAxis = cross(p, din);

    rot = vec4(rotation(dot(inAxis, ain), dot(inAxis, bin)), rotation(dot(aout, cross(p, dout)), dot(aout, p)));
}

vec4 apply_mueller(mat4 m, vec4 s, vec4 rot, vec4 flip) { return rotate(m * rotate(s, rot.xy), rot.zw) * flip; }

struct ScatterGeom {
    mat4 rayleigh;
    vec4 rot, flip;
    int bin;
    float frac;
};

ScatterGeom scatter_geometry(vec3 din, vec3 dout) {
    ScatterGeom g;
    float cosTheta = clamp(dot(din, dout), -1.0, 1.0);
    g.rayleigh = rayleigh_mueller(cosTheta);
    float fbin = acos(cosTheta) / PI * float(max(2, int(sceneData.skyVrtParams.z)) - 1);
    g.bin = int(floor(fbin));
    g.frac = fbin - float(g.bin);
    scatter_frame(din, dout, cosTheta, g.rot, g.flip);
    return g;
}

mat4 mie_mueller(ScatterGeom g, int aerosol) {
    int bins = max(2, int(sceneData.skyVrtParams.z));
    int base0 = (aerosol * SPECTRAL_BANDS + gBandLower) * bins;
    int base1 = (aerosol * SPECTRAL_BANDS + gBandUpper) * bins;
    vec4 lower = mix(mieMatrixBuffer.entries[base0 + g.bin], mieMatrixBuffer.entries[base0 + min(g.bin + 1, bins - 1)], g.frac);
    vec4 upper = mix(mieMatrixBuffer.entries[base1 + g.bin], mieMatrixBuffer.entries[base1 + min(g.bin + 1, bins - 1)], g.frac);
    vec4 e = mix(lower, upper, gBandFraction);
    return mueller(e.x, e.y, e.x, e.z, e.w, e.z);
}

vec4 scatter_wavelength(ScatterGeom g, vec4 s, vec3 w) {
    mat4 m = gSpectralBand.x * w.x * g.rayleigh + gMieBand.y * w.y * mie_mueller(g, 0);
    m += w.z > 0.0 ? gMieBand.w * w.z * mie_mueller(g, 1) : mat4(0.0);
    return apply_mueller(m / (4.0 * PI), s, g.rot, g.flip);
}

struct Level {
    vec3 org, dir, pos;
    vec4 air, camDepth, depth0;
    vec2 dirJitter;
    vec4 distanceRates, distanceWeights;
    float span, start, stepWeight, sampleWeight;
    int stepIndex, sampleIndex;
    uint scramble;
    vec4 result, angular;
};

const int STACK = int(SpecializedOrders);
Level S[STACK];
uint gRngIndex, gRngScramble;

vec3 spherical_around(vec3 axis, float theta, float phi) {
    vec3 a, b;
    beam_basis(axis, a, b);
    return normalize(axis * cos(theta) + (a * cos(phi) + b * sin(phi)) * sin(theta));
}

ivec2 cdf_layout(int aerosol) {
    int bins = max(2, int(sceneData.skyVrtParams.z));
    return ivec2(bins * (2 * SPECTRAL_BANDS + aerosol), bins);
}

float cdf_at(int i) { return mieMatrixBuffer.entries[i].x; }
float cdf_shape(int i) { return mieMatrixBuffer.entries[i].y; }

float cdf_cosine_width(int bin, int bins) {
    float halfWidth = 0.5 * PI / float(bins - 1);
    return 2.0 * sin(float(2 * bin + 1) * halfWidth) * sin(halfWidth);
}

float cdf_pdf(int aerosol, float cosTheta) {
    ivec2 info = cdf_layout(aerosol);
    float theta = acos(clamp(cosTheta, -1.0, 1.0));
    int bin = min(int(theta / PI * float(info.y - 1)), info.y - 2);
    float theta0 = float(bin) * PI / float(info.y - 1);
    float theta1 = float(bin + 1) * PI / float(info.y - 1);
    float fraction;

    if (bin * 2 < info.y - 1) {
        float a = sin(0.5 * theta0), b = sin(0.5 * theta1), x = sin(0.5 * theta);
        fraction = (x * x - a * a) / (b * b - a * a);
    } else {
        float a = cos(0.5 * theta0), b = cos(0.5 * theta1), x = cos(0.5 * theta);
        fraction = (a * a - x * x) / (a * a - b * b);
    }

    float shape = cdf_shape(info.x + bin);
    float density = 2.0 * mix(shape, 1.0 - shape, clamp(fraction, 0.0, 1.0));
    return density * (cdf_at(info.x + bin + 1) - cdf_at(info.x + bin)) / (2.0 * PI * cdf_cosine_width(bin, info.y));
}

vec3 cdf_sample(int aerosol, vec3 axis, float u, float phi) {
    ivec2 info = cdf_layout(aerosol);
    int lo = 0, hi = info.y - 1;

    while (hi - lo > 1) {
        int mid = (lo + hi) / 2;
        if (cdf_at(info.x + mid) < u) lo = mid; else hi = mid;
    }

    float c0 = cdf_at(info.x + lo), c1 = cdf_at(info.x + hi);
    float fraction = clamp((u - c0) / max(c1 - c0, 1e-20), 0.0, 1.0);
    float shape = cdf_shape(info.x + lo);
    float root = sqrt(max(shape * shape + (1.0 - 2.0 * shape) * fraction, 0.0));
    fraction = fraction > 0.0 ? fraction / max(shape + root, 1e-20) : 0.0;
    float theta0 = float(lo) * PI / float(info.y - 1);
    float theta1 = float(hi) * PI / float(info.y - 1);
    float theta;

    if (lo * 2 < info.y - 1) {
        float a = sin(0.5 * theta0), b = sin(0.5 * theta1);
        theta = 2.0 * asin(sqrt(mix(a * a, b * b, fraction)));
    } else {
        float a = cos(0.5 * theta0), b = cos(0.5 * theta1);
        theta = PI - 2.0 * asin(sqrt(mix(a * a, b * b, fraction)));
    }

    return spherical_around(axis, theta, phi);
}

float distance_pdf(float t, float rate) {
    float k = abs(rate);
    if (k < 1.0e-3) return 1.0;
    float mass = k < 0.01 ? k * (1.0 - k * (0.5 - k / 6.0)) : 1.0 - exp(-k);
    return k * exp(-k * (rate < 0.0 ? 1.0 - t : t)) / mass;
}

float sample_distance(float u, vec4 rates, vec4 weights, out float pdf) {
    float lower = 0.0;
    int component = 3;

    for (int i = 0; i < 3; ++i) {
        if (u < lower + weights[i]) {
            component = i;
            break;
        }
        lower += weights[i];
    }

    float local = clamp((u - lower) / max(weights[component], 1.0e-30), 0.0, 1.0);
    float rate = rates[component], k = abs(rate);

    float x = rate < 0.0 ? 1.0 - local : local;
    float t = k < 1.0e-3 ? x : -log((1.0 - x) + x * exp(-k)) / k;
    if (k >= 1.0e-3 && k < 0.01) t = x - 0.5 * k * x * (1.0 - x) + k * k * x * (1.0 - x) * (1.0 - 2.0 * x) / 6.0;
    t = clamp(t, 0.0, 1.0);

    t = rate < 0.0 ? 1.0 - t : t;
    vec4 magnitudes = abs(rates);
    vec4 mass, scale;

    for (int i = 0; i < 4; ++i) {
        mass[i] = magnitudes[i] < 0.01 ? magnitudes[i] * (1.0 - magnitudes[i] * (0.5 - magnitudes[i] / 6.0)) : 1.0 - exp(-magnitudes[i]);
        scale[i] = magnitudes[i] < 1.0e-3 ? 0.0 : weights[i] * magnitudes[i] / mass[i];
    }

    float lo = 0.0, hi = 1.0;
    for (int iteration = 0; iteration < 32; ++iteration) {
        float cdf = 0.0;
        pdf = 0.0;

        for (int i = 0; i < 4; ++i) {
            if (magnitudes[i] < 1.0e-3) {
                cdf += weights[i] * t;
                pdf += weights[i];
            } else {
                float x = rates[i] < 0.0 ? 1.0 - t : t;
                float e = exp(-magnitudes[i] * x);
                float z = magnitudes[i] * x;
                float cumulative = z < 0.01 ? z * (1.0 - z * (0.5 - z / 6.0)) : 1.0 - e;
                float componentCdf = cumulative / mass[i];
                cdf += weights[i] * (rates[i] < 0.0 ? 1.0 - componentCdf : componentCdf);
                pdf += scale[i] * e;
            }
        }

        float residual = cdf - u;
        if (abs(residual) <= 1.0e-7 || hi - lo <= 1.0e-7) break;
        if (residual < 0.0) lo = t; else hi = t;

        float candidate = t - residual / pdf;
        t = iteration % 4 == 3 || candidate <= lo || candidate >= hi ? 0.5 * (lo + hi) : candidate;
    }

    pdf = 0.0;
    for (int i = 0; i < 4; ++i) pdf += weights[i] * distance_pdf(t, rates[i]);
    return t;
}

void begin_step(int d, int steps) {
    uint dimension = TRANSPORT_DIMENSION + 4u * uint(d);
    uint scramble = Hash(S[d].scramble ^ uint(S[d].stepIndex) * 0x9e3779b9u);
    float u = (float(S[d].stepIndex) + SampleFloat(gRngIndex, dimension, scramble)) / float(steps);

    float pdf;

    float t = sample_distance(u, S[d].distanceRates, S[d].distanceWeights, pdf);
    S[d].dirJitter = vec2(SampleFloat(gRngIndex, dimension + 1u, scramble), SampleFloat(gRngIndex, dimension + 2u, scramble));
    S[d].stepWeight = S[d].span / (float(steps) * pdf);
    S[d].pos = S[d].org + S[d].dir * (S[d].start + t * S[d].span);
    S[d].air = air_density(S[d].pos);
    S[d].camDepth = max(S[d].depth0 - sun_air_depth(S[d].pos, S[d].dir), vec4(0.0));
    S[d].angular = vec4(0.0);
    S[d].sampleIndex = 0;
}

vec4 level_value(bool leaf, ScatterGeom g, int d) {
    if (leaf) return stokes_make_physical(scatter_wavelength(g, vec4(1.0, 0.0, 0.0, 0.0), S[d].result.xyz));
    return stokes_make_physical(S[d].result);
}

void scatter_order(vec3 origin, vec3 viewDir, vec3 L, int order, int viewSteps, int secondarySteps, inout vec4 sky) {
    int last = clamp(order, 1, STACK) - 1, d = 0;
    S[0].org = origin;
    S[0].dir = viewDir;
    S[0].scramble = gRngScramble;
    bool entering = true;

    while (true) {
        int steps = d == 0 ? viewSteps : secondarySteps;
        if (entering) {
            entering = false;
            float tEnd;
            if (!view_segment(S[d].org, S[d].dir, S[d].start, tEnd)) {
                if (d-- == 0) return;
                ++S[d].sampleIndex;
                continue;
            }

            vec3 first = S[d].org + S[d].dir * S[d].start;
            S[d].span = max(tEnd - S[d].start, 1.0e-3);
            S[d].depth0 = sun_air_depth(first, S[d].dir);
            vec4 total = max(S[d].depth0 - sun_air_depth(first + S[d].dir * S[d].span, S[d].dir), vec4(0.0));
            float tau = dot(sceneData.proposalExtinction, total);
            float altitudeChange = length(first + S[d].dir * S[d].span) - length(first);
            vec3 scaleHeights = vec3(sceneData.skyRadiiScaleHeights.zw, sceneData.skyVrtParams.w);
            S[d].distanceRates = vec4(0.0, clamp(vec3(clamp(tau, 0.0, 8.0)) + altitudeChange / scaleHeights, vec3(-32.0), vec3(32.0)));
            if (dot(first, S[d].dir) < 0.0 && dot(first, S[d].dir) + S[d].span > 0.0) S[d].distanceRates = vec4(clamp(tau, 0.0, 8.0));
            vec3 scattering = max(total.xyw * sceneData.proposalScattering.xyz, vec3(0.0));
            float scatteringSum = dot(scattering, vec3(1.0));
            S[d].distanceWeights = scatteringSum > 1.0e-30 ? vec4(0.1, 0.9 * scattering / scatteringSum) : vec4(1.0, 0.0, 0.0, 0.0);
            S[d].result = vec4(0.0);
            S[d].stepIndex = 0;
            begin_step(d, steps);
        }

        if (d < last && S[d].sampleIndex == 0) {
            float u = S[d].dirJitter.x;
            float phi = GOLDEN_ANGLE * float(S[d].stepIndex) + 2.0 * PI * S[d].dirJitter.y;
            S[d + 1].org = S[d].pos;
            vec3 next;

            vec3 current = S[d].dir;
            vec3 strength = max(S[d].air.xyw * sceneData.proposalScattering.xyz, vec3(0.0));
            vec3 weights = 0.8 * strength / max(dot(strength, vec3(1.0)), 1.0e-30);
            float fine = 0.5 * weights.y, coarse = 0.5 * weights.z;
            float uniformWeight = 1.0 - dot(weights, vec3(1.0));
            float rayleigh = 0.5 * weights.x;
            float masses[7] = float[7](fine, coarse, fine, coarse, rayleigh, rayleigh, uniformWeight);
            float lower = 0.0;
            int component = 6;

            for (int i = 0; i < 6; ++i) {
                if (u < lower + masses[i]) {
                    component = i;
                    break;
                }

                lower += masses[i];
            }

            u = clamp((u - lower) / masses[component], 0.0, 1.0);

            if (component < 4) {
                next = cdf_sample(component % 2, component < 2 ? L : current, u, phi);
            } else if (component < 6) {
                float mu = 2.0 * sinh(asinh(4.0 * u - 2.0) / 3.0);
                next = spherical_around(component == 4 ? L : current, acos(clamp(mu, -1.0, 1.0)), phi);
            } else { next = spherical_around(current, acos(1.0 - 2.0 * u), phi); }

            float cosSun = dot(next, L), cosCurrent = dot(next, current);
            float pdf = (uniformWeight + rayleigh * 0.75 * (2.0 + cosCurrent * cosCurrent + cosSun * cosSun)) / (4.0 * PI) + fine * (cdf_pdf(0, cosSun) + cdf_pdf(0, cosCurrent));
            pdf += coarse > 0.0 ? coarse * (cdf_pdf(1, cosSun) + cdf_pdf(1, cosCurrent)) : 0.0;
            S[d].sampleWeight = 1.0 / pdf;
            S[d + 1].scramble = Hash(S[d].scramble ^ uint(S[d].stepIndex) * 0x9e3779b9u ^ uint(S[d].sampleIndex) * 0x68bc21ebu ^ 0xa511e9b3u);
            S[++d].dir = next;
            entering = true;
            continue;
        }

        vec4 midDepth = S[d].camDepth;
        if (d < last) {
            S[d].result += S[d].angular * (wavelength_transmittance(midDepth) * S[d].stepWeight);
        } else if (ray_sphere(S[d].pos, L, sceneData.skyRadiiScaleHeights.x).x <= 0.0) {
            vec4 depth = sun_air_depth(S[d].pos, L);
            S[d].result.xyz += S[d].air.xyw * (wavelength_transmittance(midDepth) * S[d].stepWeight * gSpectralBand.y * sceneData.sunDisk.x * wavelength_transmittance(depth));
        }

        if (++S[d].stepIndex < steps) {
            begin_step(d, steps);
            continue;
        }

        bool leaf = d == last;
        ScatterGeom sunGeom;
        if (leaf) sunGeom = scatter_geometry(-L, -S[d].dir);

        int child = d;
        if (d-- == 0) {
            sky += level_value(leaf, sunGeom, child);
            return;
        }

        ScatterGeom g = scatter_geometry(-S[child].dir, -S[d].dir);
        S[d].angular += scatter_wavelength(g, level_value(leaf, sunGeom, child), S[d].air.xyw) * S[d].sampleWeight;
        ++S[d].sampleIndex;
    }
}

vec4 render_sky(vec3 viewDir, vec3 L) {
    vec3 origin = vec3(0.0, sceneData.skyRadiiScaleHeights.x + 1.0, 0.0);
    vec4 sky = vec4(0.0);
    float groundT = ray_sphere(origin, viewDir, sceneData.skyRadiiScaleHeights.x).x;
    int orders = groundT > 0.0 ? 1 : int(SpecializedOrders);
    uint orderScramble = gRngScramble;

    for (int order = 1; order <= orders; ++order) {
        gRngScramble = Hash(orderScramble ^ uint(order) * 0x68bc21ebu);
        scatter_order(origin, viewDir, L, order, int(SpecializedViewSteps), int(SpecializedSecondarySamples), sky);
    }

    vec3 vertical, horizontal;
    beam_basis(L, horizontal, vertical);
    vec2 offset = vec2(dot(viewDir, cross(vertical, L)), dot(viewDir, vertical));
    float r = dot(viewDir, L) > 0.0 ? length(offset) : 1.0;
    float disk = r <= sin(sceneData.skySunDirectionRadius.w) ? 1.0 : 0.0;
    vec4 depth = sun_air_depth(origin, viewDir);
    bool sunVisible = disk > 0.0 && groundT <= 0.0;
    float intensity = sunVisible ? disk * gSpectralBand.y * wavelength_transmittance(depth) : 0.0;
    sky.x += intensity;
    return stokes_make_physical(sky);
}

void set_wavelength(float wavelengthNm) {
    gWavelengthNm = wavelengthNm;
    float bandPosition = clamp((wavelengthNm - LAMBDA_MIN_NM) / LAMBDA_STEP_NM, 0.0, float(SPECTRAL_BANDS - 1));
    gBandLower = int(floor(bandPosition));
    gBandUpper = min(gBandLower + 1, SPECTRAL_BANDS - 1);
    gBandFraction = bandPosition - float(gBandLower);
    gSpectralBand = mix(sceneData.spectralBands[gBandLower], sceneData.spectralBands[gBandUpper], gBandFraction);
    gCieXyz = mix(sceneData.cieXyz[gBandLower], sceneData.cieXyz[gBandUpper], gBandFraction);
    gMieBand = mix(sceneData.mieBands[gBandLower], sceneData.mieBands[gBandUpper], gBandFraction);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.imageSize.x || pixel.y >= pc.imageSize.y) return;
    uint pixelSeed = Hash(pixel.x + pixel.y * 9781u), frameSampleBase = uint(pc.frame.x);
    uint rngScramble = pixelSeed ^ 0x5bd1e995u;
    bool polarized = pc.polarizer.x > 0.5;
    float linAmp = cos(2.0 * pc.polarizer.z);
    vec4 analyzer = vec4(1.0, linAmp * cos(2.0 * pc.polarizer.y), linAmp * sin(2.0 * pc.polarizer.y), sin(2.0 * pc.polarizer.z));
    vec3 sun = normalize(sceneData.skySunDirectionRadius.xyz);

    uint sobolIndex = frameSampleBase;
    vec2 jitter = vec2(SampleFloat(sobolIndex, 0u, pixelSeed), SampleFloat(sobolIndex, 1u, pixelSeed));
    float wavelengthNm = LAMBDA_MIN_NM + LAMBDA_RANGE_NM * SampleFloat(sobolIndex, WAVELENGTH_DIMENSION, Hash(pixelSeed ^ 0x7f4a7c15u));
    set_wavelength(wavelengthNm);
    vec2 uv = (vec2(pixel) + jitter) / vec2(pc.imageSize);
    vec2 screen = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec3 viewDir = normalize(pc.forward.xyz + pc.right.xyz * screen.x + pc.up.xyz * screen.y);
    vec3 frameX = normalize(pc.right.xyz - viewDir * dot(pc.right.xyz, viewDir)), na, nb;
    beam_basis(-viewDir, na, nb);
    gRngIndex = sobolIndex;
    gRngScramble = rngScramble;
    vec4 sky = render_sky(viewDir, sun);
    float radiance = polarized ? 0.5 * dot(analyzer, vec4_reframe(sky, na, nb, frameX)) : sky.x;
    vec3 xyz = max(radiance, 0.0) * gCieXyz.xyz * (LAMBDA_RANGE_NM / LAMBDA_STEP_NM);

    uint index = pixel.y * pc.imageSize.x + pixel.x;
    vec4 previous = pc.frame.z > 0.5 ? vec4(0.0) : accumulation.pixels[index];
    xyz = previous.xyz + (xyz - previous.xyz) / (previous.w + 1.0);
    accumulation.pixels[index] = vec4(xyz, previous.w + 1.0);
    vec3 rgb = mat3(3.2406, -0.9689, 0.0557, -1.5372, 1.8758, -0.2040, -0.4986, 0.0415, 1.0570) * xyz;
    float lowest = min(rgb.r, min(rgb.g, rgb.b));
    rgb = lowest < 0.0 && xyz.y > 0.0 ? xyz.y + (rgb - xyz.y) * (xyz.y / (xyz.y - lowest)) : rgb;
    rgb = max(rgb, vec3(0.0)) * pc.frame.y;

    const mat3 agxInset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051, 0.0784335999999992, 0.878468636469772, 0.0784336, 0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 agxOutset = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438, -0.0980208811401368, 1.15190312990417, -0.0980434501171241, -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    vec3 x = (clamp(log2(max(agxInset * rgb, vec3(1.0e-10))), -12.47393, 4.026069) + 12.47393) / 16.499999;
    x = 15.5 * x * x * x * x * x * x - 40.14 * x * x * x * x * x + 31.96 * x * x * x * x - 6.868 * x * x * x + 0.4298 * x * x + 0.1191 * x - 0.00232;
    vec3 c = min(pow(max(agxOutset * x, vec3(0.0)), vec3(2.2)), 1.0);
    c = mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, 12.92 * c, lessThanEqual(c, vec3(0.0031308)));
    imageStore(outputImage, ivec2(pixel), vec4(c, 1.0));
}
