/// @file Main.comp
/// @brief Vulkan compute shader that renders a sky with deterministic single-scattering integration.
///
/// The shader integrates Stokes radiance independently each frame and writes a tone-mapped image.
#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/// Storage image written by this workgroup's pixel invocation.
layout(set = 0, binding = 0) uniform writeonly image2D outputImage;
layout(set = 0, binding = 1) uniform SceneData {
	vec4 skyParams, skySunDirectionRadius;
	vec4 rayleigh, sunParams;
}
sceneData; ///< Scene uniforms shared by the host and compute shader.

layout(push_constant) uniform PushConstants {
	vec4 forward, right, up, polarizer;
	uvec2 imageSize;
}
pc; ///< Per-dispatch camera, exposure, polarization, and image data.

const float PI = 3.14159265358979323846; ///< Pi

vec3 gRayleighCoefficient; ///< Rayleigh scattering coefficient for each color channel.

/// Evaluates the exponential Rayleigh density at a world-space position.
/// @param pos Position in world space, in metres.
/// @return Relative Rayleigh density.
float air_density(vec3 pos) {
	float h = max(length(pos) - sceneData.skyParams.x, 0.0);
	return exp(-h / sceneData.skyParams.z);
}

/// Computes the near and far intersections of a ray with a sphere.
/// @param origin Ray origin in world space.
/// @param dir Unit ray direction.
/// @param radius Sphere radius, in metres.
/// @return Near and far ray distances, or (-1, -1) when there is no intersection.
vec2 ray_sphere(vec3 origin, vec3 dir, float radius) {
	float b = dot(origin, dir);
	float d = b * b - dot(origin, origin) + radius * radius;
	if (d < 0.0) return vec2(-1.0);
	return vec2(-b - sqrt(d), -b + sqrt(d));
}

/// Clips a ray to the atmosphere and stops it at the ground when it intersects the planet.
/// @param origin Ray origin in world space.
/// @param dir Unit ray direction.
/// @param[out] tStart Distance to the atmosphere entry point, clamped to zero.
/// @param[out] tEnd Distance to the atmosphere exit or ground intersection.
/// @return Whether the ray intersects the atmosphere.
bool view_segment(vec3 origin, vec3 dir, out float tStart, out float tEnd) {
	vec2 atmosphere = ray_sphere(origin, dir, sceneData.skyParams.y);
	vec2 ground = ray_sphere(origin, dir, sceneData.skyParams.x);
	tStart = max(atmosphere.x, 0.0);

	tEnd = ground.x > 0.0 ? min(atmosphere.y, ground.x) : atmosphere.y;
	return atmosphere.y >= 0.0;
}

/// Integrates the exponential Rayleigh density over a finite ray segment.
/// @param origin Segment origin in world space, in metres.
/// @param dir Unit ray direction.
/// @param distance Segment length, in metres. The segment must stay above ground.
/// @return Integrated relative density, in metres.
float air_depth(vec3 origin, vec3 dir, float distance) {
	if (distance <= 0.0) return 0.0;
	float closest = clamp(-dot(origin, dir), 0.0, distance);
	float column = 0.0;

	for (int segment = 0; segment < 2; ++segment) {
		float start = segment == 0 ? 0.0 : closest;
		float span = segment == 0 ? closest : distance - closest;
		if (span <= 0.0) continue;
		int panels = max(1, int(ceil(span / (8.0 * sceneData.skyParams.z))));
		float width = span / float(panels);
		for (int panel = 0; panel < panels; ++panel) {
			float t = start + (float(panel) + 0.5) * width;
			column += width * air_density(origin + dir * t);
		}
	}

	return column;
}

/// Integrates the Rayleigh density column from an atmospheric point toward space.
/// @param origin Position inside the atmosphere, in metres.
/// @param dir Unit direction along a ray that is not occluded by the planet.
/// @return Integrated relative density, in metres.
float sun_air_depth(vec3 origin, vec3 dir) {
	return air_depth(origin, dir, ray_sphere(origin, dir, sceneData.skyParams.y).y);
}

/// Evaluates per-channel atmospheric transmittance.
/// @param depth Integrated Rayleigh density column.
/// @return Per-channel fraction of radiance transmitted through the segment.
vec3 rayleigh_transmittance(float depth) { return exp(-gRayleighCoefficient * depth); }

/// Constructs the renderer's structured Mueller matrix from its independent terms.
/// @param m11 First intensity term.
/// @param m12 Intensity and linear-polarization coupling term.
/// @param m22 Second linear-polarization term.
/// @param m33 First circular-polarization term.
/// @param m34 Coupling between the two circular-polarization terms.
/// @param m44 Second circular-polarization term.
/// @return Mueller matrix in the shader's Stokes convention.
mat4 mueller(float m11, float m12, float m22, float m33, float m34, float m44) { return mat4(m11, m12, 0.0, 0.0, m12, m22, 0.0, 0.0, 0.0, 0.0, m33, -m34, 0.0, 0.0, m34, m44); }

/// Clamps Stokes radiance to nonnegative intensity and valid polarization magnitude.
/// @param s Input matrix with one vec4 Stokes column per color channel.
/// @return Physically valid Stokes radiance.
mat3x4 stokes_make_physical(mat3x4 s) {
	vec3 intensity = max(vec3(s[0].x, s[1].x, s[2].x), vec3(0.0));
	vec3 q = vec3(s[0].y, s[1].y, s[2].y);
	vec3 u = vec3(s[0].z, s[1].z, s[2].z);
	vec3 v = vec3(s[0].w, s[1].w, s[2].w);
	vec3 p = sqrt(q * q + u * u + v * v);
	vec3 scale = min(vec3(1.0), intensity / max(p, vec3(1.0e-20)));
	return mat3x4(vec4(intensity.x, q.x * scale.x, u.x * scale.x, v.x * scale.x), vec4(intensity.y, q.y * scale.y, u.y * scale.y, v.y * scale.y), vec4(intensity.z, q.z * scale.z, u.z * scale.z, v.z * scale.z));
}

/// Builds an orthonormal polarization basis perpendicular to a direction.
/// @param d Unit direction of propagation.
/// @param[out] a First transverse basis vector.
/// @param[out] b Second transverse basis vector, equal to cross(d, a).
void beam_basis(vec3 d, out vec3 a, out vec3 b) {
	vec3 up = abs(d.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
	a = normalize(up - d * dot(d, up));
	b = cross(d, a);
}

/// Converts cosine and sine of an angle to cosine and sine of twice that angle.
/// @param c Cosine of the angle.
/// @param sn Sine of the angle.
/// @return Cosine and sine of twice the angle.
vec2 rotation(float c, float sn) { return vec2(c * c - sn * sn, 2.0 * c * sn); }

/// Rotates the linear-polarization components of a Stokes vector.
/// @param s Input Stokes vector ordered as I, Q, U, V.
/// @param r Cosine and sine of twice the basis rotation angle.
/// @return Stokes vector expressed in the rotated basis.
vec4 rotate(vec4 s, vec2 r) { return vec4(s.x, s.y * r.x + s.z * r.y, -s.y * r.y + s.z * r.x, s.w); }

/// Rotates each Stokes column using the same polarization basis change.
/// @param s Matrix with one vec4 Stokes column per color channel.
/// @param r Cosine and sine of twice the basis rotation angle.
/// @return Rotated Stokes matrix.
mat3x4 rotate(mat3x4 s, vec2 r) { return mat3x4(rotate(s[0], r), rotate(s[1], r), rotate(s[2], r)); }

/// Re-expresses Stokes radiance using a new transverse reference axis.
/// @param s Matrix with one vec4 Stokes column per color channel.
/// @param oldA First axis of the input basis.
/// @param oldB Second axis of the input basis.
/// @param newA First axis of the destination basis.
/// @return Stokes radiance expressed in the destination basis.
mat3x4 rgb_stokes_reframe(mat3x4 s, vec3 oldA, vec3 oldB, vec3 newA) { return rotate(s, rotation(dot(newA, oldA), dot(newA, oldB))); }

/// Evaluates the Rayleigh Mueller matrix at a scattering angle.
/// @param cosTheta Cosine of the angle between incoming and outgoing directions.
/// @return Rayleigh Mueller matrix including configured depolarization.
mat4 rayleigh_mueller(float cosTheta) {
	float kingDepolarization = sceneData.skyParams.w;
	float kingFactor = (1.0 - kingDepolarization) / (1.0 + 0.5 * kingDepolarization);
	float polarizationFactor = (1.0 - 2.0 * kingDepolarization) / max(1.0 - kingDepolarization, 1.0e-4);
	float mu2 = cosTheta * cosTheta;
	float base = 0.75 * (1.0 + mu2), p33 = 1.5 * cosTheta;
	return mueller(mix(1.0, base, kingFactor), -kingFactor * 0.75 * (1.0 - mu2), kingFactor * base, kingFactor * p33, 0.0, kingFactor * polarizationFactor * p33);
}

/// Computes polarization-frame rotations and sign corrections for a scattering event.
/// @param din Incoming unit direction.
/// @param dout Outgoing unit direction.
/// @param cosTheta Cosine of the scattering angle.
/// @param[out] rot Input and output double-angle rotations.
/// @param[out] flip Stokes-component signs for degenerate frames.
void scatter_frame(vec3 din, vec3 dout, float cosTheta, out vec4 rot, out vec4 flip) {
	rot = vec4(1.0, 0.0, 1.0, 0.0);
	flip = vec4(1.0);
	vec3 p = cross(din, dout);
	float pl = length(p);

	if (pl < 1.0e-6) {
		if (cosTheta < 0.0) flip = vec4(1.0, 1.0, -1.0, -1.0);
		return;
	}

	p /= pl;
	vec3 ain, bin, aout, bout;
	beam_basis(din, ain, bin);
	beam_basis(dout, aout, bout);
	vec3 inAxis = cross(p, din);

	rot = vec4(rotation(dot(inAxis, ain), dot(inAxis, bin)), rotation(dot(aout, cross(p, dout)), dot(aout, p)));
}

/// Applies a Mueller matrix to Stokes radiance between rotated polarization frames.
/// @param m Scattering Mueller matrix.
/// @param s Matrix with one vec4 Stokes column per color channel.
/// @param rot Input and output double-angle rotations.
/// @param flip Stokes-component signs for degenerate frames.
/// @return Output Stokes radiance.
mat3x4 apply_mueller(mat4 m, mat3x4 s, vec4 rot, vec4 flip) {
	mat3x4 result = rotate(m * rotate(s, rot.xy), rot.zw);
	return mat3x4(result[0] * flip, result[1] * flip, result[2] * flip);
}

/// Geometry shared by Rayleigh scattering and polarization-frame changes.
struct ScatterGeom {
	mat4 rayleigh; ///< Rayleigh Mueller matrix for the current scattering angle.
	vec4 rot; ///< Input and output Stokes-frame rotations, stored as cos(2 theta), sin(2 theta) pairs.
	vec4 flip; ///< Stokes-component sign correction for degenerate forward or backward frames.
};

/// Computes the Rayleigh Mueller matrix and polarization frames for a scattering event.
/// @param din Incoming unit direction.
/// @param dout Outgoing unit direction.
/// @return Scattering geometry.
ScatterGeom scatter_geometry(vec3 din, vec3 dout) {
	ScatterGeom g;
	float cosTheta = clamp(dot(din, dout), -1.0, 1.0);
	g.rayleigh = rayleigh_mueller(cosTheta);
	scatter_frame(din, dout, cosTheta, g.rot, g.flip);
	return g;
}

/// Applies Rayleigh scattering and Stokes-frame changes.
/// @param g Scattering geometry and polarization frame data.
/// @param intensity Input intensity for each color channel.
/// @return Scattered Stokes radiance.
mat3x4 scatter_color(ScatterGeom g, vec3 intensity) {
	mat3x4 source = mat3x4(vec4(intensity.x, 0.0, 0.0, 0.0), vec4(intensity.y, 0.0, 0.0, 0.0), vec4(intensity.z, 0.0, 0.0, 0.0));
	mat3x4 scattered = apply_mueller(g.rayleigh / (4.0 * PI), source, g.rot, g.flip);
	return mat3x4(scattered[0] * gRayleighCoefficient.x, scattered[1] * gRayleighCoefficient.y, scattered[2] * gRayleighCoefficient.z);
}

/// Integrates single scattering along the primary view ray.
/// @param origin Ray origin in world space.
/// @param viewDir Unit direction from the camera into the atmosphere.
/// @param L Unit direction toward the Sun.
/// @return Stokes radiance scattered toward the camera.
mat3x4 scatter(vec3 origin, vec3 viewDir, vec3 L) {
	float start, end;
	if (!view_segment(origin, viewDir, start, end) || end <= start)
		return mat3x4(vec4(0.0), vec4(0.0), vec4(0.0));

	float span = end - start;
	vec3 entry = origin + viewDir * start;
	vec3 result = vec3(0.0);

	vec3 pos = origin + viewDir * (start + span * 0.25);
	if (ray_sphere(pos, L, sceneData.skyParams.x).x <= 0.0) {
		float cameraDepth = air_depth(entry, viewDir, span * 0.25);
		float sunDepth = sun_air_depth(pos, L);
		result += air_density(pos) * rayleigh_transmittance(cameraDepth + sunDepth) * span;
	}

	result *= sceneData.sunParams.y * sceneData.sunParams.x;
	ScatterGeom sunGeom = scatter_geometry(-L, -viewDir);
	return stokes_make_physical(scatter_color(sunGeom, result));
}

/// Evaluates Stokes radiance, including the visible solar disk.
/// @param viewDir Unit direction from the camera into the atmosphere.
/// @param L Unit direction toward the Sun.
/// @param rayDx Change in view direction across one horizontal pixel.
/// @param rayDy Change in view direction across one vertical pixel.
/// @param[out] sunIntensity Unpolarized solar radiance for a fully covered pixel.
/// @param[out] sunCoverage Filtered solar disk coverage.
/// @return Atmospheric Stokes radiance without the direct solar disk.
mat3x4 render_sky(vec3 viewDir, vec3 L, vec3 rayDx, vec3 rayDy, out vec3 sunIntensity, out float sunCoverage) {
	vec3 origin = vec3(0.0, sceneData.skyParams.x + 1.0, 0.0);
	float groundT = ray_sphere(origin, viewDir, sceneData.skyParams.x).x;
	mat3x4 sky = scatter(origin, viewDir, L);
	vec3 radial = viewDir - L * dot(viewDir, L);
	float r = length(radial);
	vec3 edgeNormal = radial / max(r, 1.0e-8);
	float pixelWidth = max(abs(dot(edgeNormal, rayDx)) + abs(dot(edgeNormal, rayDy)), 1.0e-8);
	float radius = sin(sceneData.skySunDirectionRadius.w);
	float halfEdgeWidth = 0.5 * pixelWidth;
	float disk = dot(viewDir, L) > 0.0 ? 1.0 - smoothstep(radius - halfEdgeWidth, radius + halfEdgeWidth, r) : 0.0;
	bool sunVisible = disk > 0.0 && groundT <= 0.0;
	sunCoverage = sunVisible ? disk : 0.0;
	sunIntensity = sunVisible ? sceneData.sunParams.y * rayleigh_transmittance(sun_air_depth(origin, viewDir)) : vec3(0.0);
	return stokes_make_physical(sky);
}

/// Tone-maps radiance into linear display RGB before coverage filtering.
/// @param radiance Scene radiance before applying the configured exposure.
/// @return Tone-mapped linear display RGB.
vec3 tone_map(vec3 radiance) {
	vec3 rgb = max(radiance, vec3(0.0)) * pc.polarizer.w;
	const mat3 agxInset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051, 0.0784335999999992, 0.878468636469772, 0.0784336, 0.0792237451477643, 0.0791661274605434, 0.879142973793104);
	const mat3 agxOutset = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438, -0.0980208811401368, 1.15190312990417, -0.0980434501171241, -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
	vec3 x = (clamp(log2(max(agxInset * rgb, vec3(1.0e-10))), -12.47393, 4.026069) + 12.47393) / 16.499999;
	x = 15.5 * x * x * x * x * x * x - 40.14 * x * x * x * x * x + 31.96 * x * x * x * x - 6.868 * x * x * x + 0.4298 * x * x + 0.1191 * x - 0.00232;
	return min(pow(max(agxOutset * x, vec3(0.0)), vec3(2.2)), 1.0);
}

/// Integrates one fixed pixel-center ray and writes its display color.
void main() {
	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (pixel.x >= pc.imageSize.x || pixel.y >= pc.imageSize.y) return;
	float linAmp = cos(2.0 * pc.polarizer.z);
	vec4 analyzer = vec4(1.0, linAmp * cos(2.0 * pc.polarizer.y), linAmp * sin(2.0 * pc.polarizer.y), sin(2.0 * pc.polarizer.z));
	vec3 sun = normalize(sceneData.skySunDirectionRadius.xyz);
	vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(pc.imageSize);
	vec2 screen = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 ray = pc.forward.xyz + pc.right.xyz * screen.x + pc.up.xyz * screen.y;
	float rayLength = length(ray);
	vec3 viewDir = ray / rayLength;
	vec3 rayDx = (pc.right.xyz - viewDir * dot(viewDir, pc.right.xyz)) * (2.0 / float(pc.imageSize.x)) / rayLength;
	vec3 rayDy = (pc.up.xyz - viewDir * dot(viewDir, pc.up.xyz)) * (-2.0 / float(pc.imageSize.y)) / rayLength;
	vec3 frameX = normalize(pc.right.xyz - viewDir * dot(pc.right.xyz, viewDir)), na, nb;

	beam_basis(-viewDir, na, nb);
	gRayleighCoefficient = sceneData.rayleigh.xyz;
	vec3 sunIntensity;
	float sunCoverage;

	mat3x4 sky = render_sky(viewDir, sun, rayDx, rayDy, sunIntensity, sunCoverage);
	vec3 radiance = vec3(sky[0].x, sky[1].x, sky[2].x);
	if (pc.polarizer.x > 0.5) {
		mat3x4 framedSky = rgb_stokes_reframe(sky, na, nb, frameX);
		radiance = 0.5 * (transpose(framedSky) * analyzer);
		sunIntensity *= 0.5;
	}

	vec3 c = mix(tone_map(radiance), tone_map(radiance + sunIntensity), sunCoverage);
	c = mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, 12.92 * c, lessThanEqual(c, vec3(0.0031308)));
	imageStore(outputImage, ivec2(pixel), vec4(c, 1.0));
}
