{
  "version": 6,
  "configurePresets": [
    {
      "name": "wsl",
      "displayName": "WSL 2",
      "description": "Ninja + GCC 15 on WSL 2",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-wsl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    { "name": "wsl", "configurePreset": "wsl" }
  ]
}
